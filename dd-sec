# Repo and branch are CHOSEN FROM THE DATA, never typed. That removes the whole
# class of failure this menu kept producing: a repo id pasted into the branch
# prompt, or a branch typed onto the end of a pasted repo id. It also removes
# the guessing - the identifiers offered are the exact strings Datadog holds.
menu_sast() {
  local sast_days=30
  while :; do
    ui_select "SAST violations (cicodescan) · lookback ${sast_days} days" \
      "General - all repos (org-wide)" \
      "Pick a repo from the data" \
      "General, all categories (including code_style)" \
      "Change lookback (currently ${sast_days} days)" \
      "Repo identifiers present in the data" \
      "Probe filters - find which filter kills the result" \
      "← Back" || return 0
    case "$UI_INDEX" in
      0) run_action cmd_sast_list --days "$sast_days"; pause ;;
      1) menu_sast_repo "$sast_days" ;;
      2) run_action cmd_sast_list --days "$sast_days" --all-categories; pause ;;
      3) ui_select "Lookback" "7 days" "30 days" "90 days" "180 days" "Type manually" "← Cancel" || continue
         case "$UI_INDEX" in
           0) sast_days=7 ;; 1) sast_days=30 ;; 2) sast_days=90 ;; 3) sast_days=180 ;;
           4) ui_text "Lookback (days)" "30" || continue
              case "$UI_VALUE" in
                ''|*[!0-9]*) warn "Must be a number" ;;
                *) sast_days="$UI_VALUE" ;;
              esac ;;
         esac ;;
      4) run_action cmd_sast_repos "$sast_days"; pause ;;
      5) menu_sast_probe "$sast_days" ;;
      6) return 0 ;;
    esac
  done
}

menu_sast_repo() { # days
  local days="$1" repo_id="" branch=""
  step "Fetching the repo list from the data (${days} days)..."
  local rl; rl="$(mktemp)"
  sast_repo_list "$days" > "$rl" 2>/dev/null
  local nrepo; nrepo="$(grep -c '[^[:space:]]' < "$rl" || true)"

  if [ "${nrepo:-0}" -eq 0 ]; then
    warn "No repos readable on the cicodescan track (${days} days)."
    dim "  This does not mean the code is clean. Possibly: lookback too short,"
    dim "  Code Security not enabled for that repo, or the app key lacks"
    dim "  code_analysis_read. Check with: Probe filters, or $PROG auth probe"
    rm -f "$rl"; pause; return 0
  fi

  # Labels carry the event count, so an identifier with no data is visible as
  # such before it is chosen.
  local labels=() ids=() line rid cnt
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    IFS=$'\x1f' read -r rid cnt <<< "${line//$'\t'/$'\x1f'}"
    ids+=("$rid"); labels+=("$rid  (${cnt} event)")
  done < "$rl"
  rm -f "$rl"
  labels+=("← Back")

  ui_select "Pick repo (${nrepo} found)" "${labels[@]}" || return 0
  [ "$UI_INDEX" -lt "$nrepo" ] || return 0
  repo_id="${ids[$UI_INDEX]}"

  step "Fetching the branch list for that repo..."
  local bl; bl="$(mktemp)"
  sast_branch_list "$repo_id" "$days" > "$bl" 2>/dev/null
  local nbr; nbr="$(grep -c '[^[:space:]]' < "$bl" || true)"

  local blabels=("(all branches)") bvals=("")
  local bname bc
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    IFS=$'\x1f' read -r bname bc <<< "${line//$'\t'/$'\x1f'}"
    bvals+=("$bname"); blabels+=("$bname  (${bc} event)")
  done < "$bl"
  rm -f "$bl"
  blabels+=("← Cancel")

  if [ "${nbr:-0}" -eq 0 ]; then
    dim "  No branches readable; continuing without a branch filter."
    branch=""
  else
    ui_select "Branch in ${repo_id##*/}" "${blabels[@]}" || return 0
    [ "$UI_INDEX" -lt $(( nbr + 1 )) ] || return 0
    branch="${bvals[$UI_INDEX]}"
  fi

  ui_select "Category" "Only security" "All categories (including code_style)" "← Cancel" || return 0
  [ "$UI_INDEX" -le 1 ] || return 0
  local allcat=0
  [ "$UI_INDEX" -eq 1 ] && allcat=1

  local args=(--days "$days" --repo-id "$repo_id")
  [ -z "$branch" ] || args+=(--branch "$branch")
  [ "$allcat" -eq 0 ] || args+=(--all-categories)

  info ""
  info "  repo-id : $repo_id"
  info "  branch  : ${branch:-(all)}"
  info "  category: $([ "$allcat" -eq 1 ] && printf 'all' || printf 'security')"
  run_action cmd_sast_list "${args[@]}"
  pause
}

menu_sast_probe() { # days
  local days="$1" repo_id="" branch=""
  ui_select "Probe filters - scope" \
    "No repo filter (safest to start)" \

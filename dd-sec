  local rl; rl="$(mktemp)"
  sast_repo_list "$days" > "$rl" 2>/dev/null
  local nrepo; nrepo="$(grep -c '[^[:space:]]' < "$rl" || true)"
  if [ "${nrepo:-0}" -eq 0 ]; then
    warn "No repos in the data - running the probe without a repo filter."
    rm -f "$rl"
    run_action cmd_sast_probe --days "$days"; pause; return 0

cmd_work_list() {
  need_auth
  local filter="" size=50
  while [ $# -gt 0 ]; do
    case "$1" in
      --filter) filter="$2"; shift 2 ;; --limit) size="$2"; shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  local qs="page%5Bsize%5D=$size"
  [ -z "$filter" ] || qs="filter=$(urlencode "$filter")&$qs"

  dd_req_retry GET "/api/v2/cases?$qs" || { explain_http; return 1; }
  local n; n="$(printf '%s' "$HTTP_BODY" | jq -r '(.data // [])|length')"
  hdr "$n work item${filter:+  (filter: $filter)}"

  # The /api/v2/cases search is free-text and NOT project-scoped, so results can
  # include items from other projects. When a project is selected, non-matching
  # rows are marked rather than hidden, so nothing silently disappears.
  printf '%s' "$HTTP_BODY" | jq -r --arg p "${PROJECT_ID:-}" '
    .data[]? |
    [ (.attributes.key // "?"),
      (.attributes.status_name // "?"),
      (.attributes.priority // "?"),
      ((.relationships.project.data.id // .attributes.project_id // "") | tostring),
      (.attributes.title // "?"),
      .id ] | @tsv' \
    | awk -F'\t' -v p="${PROJECT_ID:-}" '
        { mark = (p != "" && $4 != "" && $4 != p) ? "*" : " "
          printf "%s %-12s %-22.22s %-4s %-46.46s\n", mark, $1, $2, $3, $5 }' >&2
  info ""
  [ -z "$PROJECT_ID" ] || dim "  * = work items outside the active project ($PROJECT_ID)"
  dim "  Detail: $PROG work view --key <KEY>"
}

cmd_work_view() {
  need_auth
  local key=""
  while [ $# -gt 0 ]; do
    case "$1" in --key) key="$2"; shift 2 ;; *) die "Unknown argument: $1" ;; esac
  done
  [ -n "$key" ] || die "--key required (e.g. SAST-123)"

  # Looked up through the search filter rather than a GET by id, because the key
  # is what a human has and the id is not exposed in the UI.
  dd_req_retry GET "/api/v2/cases?filter=$(urlencode "$key")&page%5Bsize%5D=50" \
    || { explain_http; return 1; }
  local item
  item="$(printf '%s' "$HTTP_BODY" | jq -c --arg k "$key" \
    '[.data[]? | select((.attributes.key // "") == $k)][0] // empty')"
  [ -n "$item" ] || die "Work item '$key' not found."

  local cid; cid="$(printf '%s' "$item" | jq -r '.id')"
  hdr "$key"
  printf '%s' "$item" | jq -r '
    "  Title      : " + (.attributes.title // "?") + "\n" +
    "  Status     : " + (.attributes.status_name // "?") + "\n" +
    "  Priority   : " + (.attributes.priority // "?") + "\n" +
    "  Created    : " + (.attributes.created_at // "?") + "\n" +
    "  Modified   : " + (.attributes.modified_at // "never modified") + "\n" +
    "  Project    : " + ((.relationships.project.data.id // .attributes.project_id // "?") | tostring) + "\n" +
    "  ID         : " + .id' >&2
  local attrs
  attrs="$(printf '%s' "$item" | jq -r '(.attributes.attributes // {}) | to_entries | map("  \(.key) = \(.value|join(","))") | join("\n")')"
  [ -z "$attrs" ] || { info ""; info "  Custom attributes:"; info "$attrs"; }
  info ""
  info "  URL: $(app_base "$DD_SITE_R")/cases/$cid"
  info ""
  printf '%s' "$item" | jq -r '(.attributes.description // "") | .[0:1500]' >&2
  info ""
  dim "  The Case Management API v2 has no read-comment endpoint, so comments"
  dim "  can only be viewed in the UI. To write a comment: work comment."
}

cmd_work_comment() {

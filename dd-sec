    } > "$rep"

  else   # markdown (default)
    {
      printf '# %s\n\n' "$title"
      printf '> **BETA** — %s\n\n' "$beta"
      printf '| | |\n|---|---|\n'
      printf '| Organization | %s |\n' "$(_rep_md_cell "${ORG_NAME:-?}")"
      printf '| Datadog site | %s |\n' "$(_rep_md_cell "${DD_SITE_R:-?}")"
      printf '| Generated (UTC) | %s |\n' "$genat"
      printf '| Findings query | `%s` |\n' "$(_rep_md_cell "$query")"
      printf '| SAST lookback | %s days |\n' "$days"
      printf '| Tool version | dd-sec %s |\n\n' "$VERSION"

      printf '## Executive summary\n\n'
      printf -- '- **%s** open findings matched the query.\n' "$F_TOT"
      printf -- '- **%s critical** and **%s high** severity.\n' "$F_CRIT" "$F_HIGH"
      if [ "$sast_ok" -eq 1 ]; then
        printf -- '- **%s** SAST violations (security category) in the last %s days.\n\n' "$S_TOT" "$days"
      else
        printf -- '- SAST section unavailable (see below).\n\n'
      fi

      printf '## Security findings — severity distribution\n\n'
      printf '| Severity | Count |\n|---|---:|\n'
      printf '| CRITICAL | %s |\n| HIGH | %s |\n| MEDIUM | %s |\n| LOW | %s |\n| INFO | %s |\n| UNKNOWN | %s |\n\n' \
        "$F_CRIT" "$F_HIGH" "$F_MED" "$F_LOW" "$F_INFO" "$F_UNK"

      printf '### Status breakdown\n\n'
      printf '| Status | Count |\n|---|---:|\n'
      local sc sn
      while IFS=$'\t' read -r sc sn; do
        [ -n "$sc" ] || continue
        printf '| %s | %s |\n' "$(_rep_md_cell "$sn")" "$sc"
      done < "$fstatus"
      printf '\n'

      printf '### Top findings (up to %s, severity-ranked)\n\n' "$topn"
      printf '| # | Severity | Status | Finding | Resource |\n|---:|---|---|---|---|\n'
      local _n=0 id sev st ti rs
      while IFS=$'\t' read -r id sev st ti rs; do
        [ -n "$id" ] || continue
        _n=$(( _n + 1 ))
        printf '| %d | %s | %s | %s | %s |\n' "$_n" "$(_rep_up "${sev:-unknown}")" \
          "$(_rep_md_cell "${st:--}")" "$(_rep_md_cell "${ti:--}")" "$(_rep_md_cell "${rs:--}")"
      done < "$ftop"
      printf '\n'

      printf '## SAST violations (cicodescan)\n\n'
      if [ "$sast_ok" -eq 1 ]; then
        printf '| Severity | Count |\n|---|---:|\n'
        printf '| CRITICAL | %s |\n| HIGH | %s |\n| MEDIUM | %s |\n| LOW | %s |\n| INFO | %s |\n| **Total** | **%s** |\n\n' \
          "$S_CRIT" "$S_HIGH" "$S_MED" "$S_LOW" "$S_INFO" "$S_TOT"
        printf '### Top repositories by violation count\n\n'
        printf '| Repository | Violations |\n|---|---:|\n'
        local rn rr
        while IFS=$'\t' read -r rn rr; do
          [ -n "$rn" ] || continue
          printf '| %s | %s |\n' "$(_rep_md_cell "$rr")" "$rn"
        done < "$stops"
        printf '\n'
      else
        printf '_Unavailable._ The app key lacks `code_analysis_read`, or the cicodescan endpoint returned an error. The findings above are unaffected.\n\n'
      fi

      printf '## Methodology & caveats\n\n'
      printf -- '- **Findings**: `GET /api/v2/security/findings` with the query above, paginated.\n'
      printf -- '- **SAST**: the internal `logs-analytics` (cicodescan) endpoint over a %s-day window. This endpoint is undocumented and its result ceiling is not guaranteed stable.\n' "$days"
      printf -- '- **Zero is not clean**: a repository last scanned outside the lookback window reads as zero here even if the UI still shows findings.\n'
      printf -- '- **Point-in-time**: finding IDs change between scans; regenerate before acting.\n'
      printf -- '- Generated by `dd-sec %s`, read-only. No findings were modified.\n' "$VERSION"
    } > "$rep"
  fi

  rm -f "$ftsv" "$ftop" "$fstatus" "$stops"

  if [ -n "$out" ]; then
    mv "$rep" "$out"; ok "Report written: $out"
    dim "  Format: $fmt · $F_TOT finding(s)$( [ "$sast_ok" -eq 1 ] && printf ', %s SAST violation(s)' "$S_TOT")"
  else
    cat "$rep"; rm -f "$rep"
  fi
}

# -----------------------------------------------------------------------------
# Interactive menu
# -----------------------------------------------------------------------------
# =============================================================================
# ARROW-KEY UI
#
# Every menu and every choice with a knowable set of values is a cursor
# selection, not typed text. That is not a cosmetic preference: three separate
# bugs in this tool came from sequential `read` prompts, and they were all the
# same bug. A pasted value carrying a leading newline satisfies the first read
# and pushes the real value into the next prompt; a pasted value WITHOUT a
# trailing newline lets the next thing typed run onto the same line, producing
# "...vulnerable-java-appmain". No amount of validation fixes input that was
# never separable in the first place.
#
# Typing is therefore reserved for what genuinely cannot be enumerated: a
# Datadog query, a justification, a custom value chosen from the list itself.
# =============================================================================

UI_INDEX=0      # 0-based index of the chosen entry
UI_VALUE=""     # its label
UI_CANCELLED=0

# Drawn on the terminal via stderr, since stdout may be captured by a caller.
_ui_hide() { printf '\033[?25l' >&2; }
_ui_show() { printf '\033[?25h' >&2; }

# ui_select TITLE OPTION...
#   Up/Down or k/j to move, Enter to choose, 1-9 to jump, q or Esc to cancel.
#   Sets UI_INDEX / UI_VALUE, or UI_CANCELLED=1 and returns 1.
#
# Without a usable terminal this degrades to a numbered prompt rather than
# failing, so the same code path works over a pipe and in CI.
ui_select() {
  local title="$1"; shift
  local n=$# i cur=0 key rest cols
  UI_CANCELLED=0; UI_INDEX=0; UI_VALUE=""
  [ "$n" -gt 0 ] || return 1

  local opts=("$@")

  if [ ! -t 0 ] || [ -n "${DD_SEC_NO_TUI:-}" ]; then
    printf '\n%s%s%s\n' "$C_BLD" "$title" "$C_OFF" >&2
    i=0
    while [ "$i" -lt "$n" ]; do
      printf '  %d) %s\n' "$(( i + 1 ))" "${opts[$i]}" >&2
      i=$(( i + 1 ))
    done
    printf '\n  Select [1-%d]: ' "$n" >&2
    local pick; IFS= read -r pick || { UI_CANCELLED=1; return 1; }
    case "$pick" in
      ''|*[!0-9]*) UI_CANCELLED=1; return 1 ;;
    esac
    [ "$pick" -ge 1 ] && [ "$pick" -le "$n" ] || { UI_CANCELLED=1; return 1; }
    UI_INDEX=$(( pick - 1 )); UI_VALUE="${opts[$UI_INDEX]}"
    return 0
  fi

  cols="$(tput cols 2>/dev/null || echo 80)"
  [ "$cols" -gt 20 ] 2>/dev/null || cols=80
  local width=$(( cols - 8 ))

  printf '\n%s%s%s\n' "$C_BLD" "$title" "$C_OFF" >&2
  dim "  ↑/↓ move · Enter select · q cancel"

  _ui_draw() {
    local j=0 label
    while [ "$j" -lt "$n" ]; do
      label="${opts[$j]}"
      [ "${#label}" -le "$width" ] || label="${label:0:$width}…"
      if [ "$j" -eq "$cur" ]; then
        printf '\033[2K  %s❯ %s%s\n' "$C_CYN" "$label" "$C_OFF" >&2
      else
        printf '\033[2K    %s\n' "$label" >&2
      fi
      j=$(( j + 1 ))
    done
  }

  # The cursor is restored even if the caller is interrupted mid-selection;
  # a terminal left without a cursor is a hostile thing to leave behind.
  trap '_ui_show; trap - INT TERM; return 130' INT TERM
  _ui_hide
  _ui_draw

  while :; do
    IFS= read -rsn1 key 2>/dev/null || { key=q; }
    case "$key" in
      $'\033')
        # An arrow is ESC [ A/B. A bare Esc has no follow-up, so the short
        # timeout is what distinguishes "cancel" from "arrow key".
        rest=""
        IFS= read -rsn2 -t 1 rest 2>/dev/null
        case "$rest" in
          '[A') cur=$(( cur > 0 ? cur - 1 : n - 1 )) ;;
          '[B') cur=$(( cur < n - 1 ? cur + 1 : 0 )) ;;
          '')   UI_CANCELLED=1; break ;;
          *)    : ;;
        esac ;;
      '')            UI_INDEX="$cur"; UI_VALUE="${opts[$cur]}"; break ;;
      k|K)           cur=$(( cur > 0 ? cur - 1 : n - 1 )) ;;
      j|J)           cur=$(( cur < n - 1 ? cur + 1 : 0 )) ;;
      g)             cur=0 ;;
      G)             cur=$(( n - 1 )) ;;
      q|Q)           UI_CANCELLED=1; break ;;
      [1-9])
        if [ "$key" -le "$n" ]; then
          cur=$(( key - 1 )); UI_INDEX="$cur"; UI_VALUE="${opts[$cur]}"; break
        fi ;;
      *) : ;;
    esac
    printf '\033[%dA' "$n" >&2
    _ui_draw
  done

  _ui_show
  trap - INT TERM
  if [ "$UI_CANCELLED" -eq 1 ]; then
    printf '\033[%dA' "$n" >&2
    cur=-1; _ui_draw
    dim "  (cancelled)"
    return 1
  fi
  return 0
}

# ui_text PROMPT [DEFAULT] -> UI_VALUE
# Kept for the things that genuinely cannot be enumerated: a query, a reason,
# a custom value. Reads on its own line so nothing can run onto it, and trims
# whitespace so a paste with stray newlines cannot shift anything.
ui_text() {
  local prompt="$1" def="${2:-}"
  UI_VALUE=""; UI_CANCELLED=0
  if [ -n "$def" ]; then printf '\n  %s%s%s [%s]\n  > ' "$C_BLD" "$prompt" "$C_OFF" "$def" >&2
  else printf '\n  %s%s%s\n  > ' "$C_BLD" "$prompt" "$C_OFF" >&2; fi
  local v=""
  IFS= read -r v || { UI_CANCELLED=1; return 1; }
  v="$(printf '%s' "$v" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -n "$v" ] || v="$def"
  UI_VALUE="$v"
  [ -n "$UI_VALUE" ] || return 1
  return 0
}

ui_confirm() { # question [default_yes]
  local q="$1" dflt="${2:-yes}" first second
  if [ "$dflt" = "yes" ]; then first="Yes"; second="No"; else first="No"; second="Yes"; fi
  ui_select "$q" "$first" "$second" || return 1
  [ "$UI_VALUE" = "Yes" ]
}

# Distinct repository ids present on the cicodescan track, newest window first.
# Reading the identifiers out of the data is the only reliable way to get them:
# the exact string Datadog holds is host+path, and no amount of guessing at
# @git.repository.name produces it.
sast_repo_list() { # days
  local days="${1:-90}" prev="$SAST_LOOKBACK_DAYS" out
  SAST_LOOKBACK_DAYS="$days"
  out="$(mktemp)"
  if ! dd_cicodescan '@static_analysis.result.item_type:static_analysis_violation' "$out" false >/dev/null 2>&1; then
    SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"; return 1
  fi
  jq -r '[ .result.events[]? | .event.custom?.git?.repository?.id?
           | select(type == "string" and . != "") ]
         | group_by(.) | map({r: .[0], n: length}) | sort_by(-.n)
         | .[] | "\(.r)\t\(.n)"' "$out" 2>/dev/null
  SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"
}

sast_branch_list() { # repo_id days
  local rid="$1" days="${2:-90}" prev="$SAST_LOOKBACK_DAYS" out
  SAST_LOOKBACK_DAYS="$days"
  out="$(mktemp)"
  local q="@static_analysis.result.item_type:static_analysis_violation"
  [ -z "$rid" ] || q="$q @git.repository.id:${rid}"
  if ! dd_cicodescan "$q" "$out" false >/dev/null 2>&1; then
    SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"; return 1
  fi
  jq -r '[ .result.events[]? | .event.custom?.git?.branch?
           | select(type == "string" and . != "") ]
         | group_by(.) | map({b: .[0], n: length}) | sort_by(-.n)
         | .[] | "\(.b)\t\(.n)"' "$out" 2>/dev/null
  SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"
}

pause() { [ -t 0 ] || return 0; printf '\n%s  [enter to continue]%s' "$C_DIM" "$C_OFF" >&2; IFS= read -r _ || true; }



banner() {
  load_creds
  local who="not logged in"
  [ -z "$DD_API_KEY_R" ] || who="${ORG_NAME:-?} @ ${DD_SITE_R:-?}"
  printf '\n%s┌─ dd-sec %s%s\n' "$C_CYN" "$VERSION" "$C_OFF" >&2
  printf '%s│%s  %s\n' "$C_CYN" "$C_OFF" "$who" >&2
  [ -z "$SEV_MODE" ] || printf '%s│%s  severity mode: %s\n' "$C_CYN" "$C_OFF" "$SEV_MODE" >&2
  printf '%s└─%s\n' "$C_CYN" "$C_OFF" >&2
}


           iac_misconfiguration \
           runtime_code_vulnerability \
           "Type manually (several allowed, comma-separated)" \
           "← Cancel" || continue
         local rty=""
         case "$UI_INDEX" in
           5) ui_text "Finding types (comma)" "static_code_vulnerability" || continue; rty="$UI_VALUE" ;;
           6) continue ;;
           *) rty="$UI_VALUE" ;;
         esac
         ui_text "Query filter (empty = all)" "" ; local rq="$UI_VALUE"
         ui_text "Description / reason (required)" "" || { warn "Reason required"; continue; }
         local rd="$UI_VALUE"
         run_action cmd_rule_create --name "$rn" "$act" "$val" --types "$rty" --query "$rq" --reason "$rd"
         ui_confirm "Create rule '$rn'?" no \
           && run_action cmd_rule_create --name "$rn" "$act" "$val" --types "$rty" --query "$rq" --reason "$rd" --apply
         pause ;;
      3) ui_text "Rule ID" "" || continue
         local rdel="$UI_VALUE"
         ui_confirm "DELETE rule $rdel?" no && run_action cmd_rule_delete --id "$rdel" --apply
         pause ;;
      4) return 0 ;;
    esac
  done
}

menu_work() {
  while :; do
    load_creds
    ui_select "Work Management · active project: ${PROJECT_ID:-not selected}" \
      "List work item" \
      "Search work item (filter)" \
      "View work item detail" \
      "Post comment" \
      "Change status" \
      "Select active project" \
      "List work type" \
      "Doctor - why not all projects are readable" \
      "Check access to one project by UUID" \
      "← Back" || return 0
    case "$UI_INDEX" in
      0) run_action cmd_work_list --limit 50; pause ;;
      1) ui_text "Filter (free-text)" "" || continue
         run_action cmd_work_list --filter "$UI_VALUE" --limit 50; pause ;;
      2) ui_text "Work item key (e.g. SAST-142)" "" || continue
         run_action cmd_work_view --key "$UI_VALUE"; pause ;;
      3) ui_text "Work item key" "" || continue
         local wk="$UI_VALUE"
         ui_text "Comment" "" || continue
         local wt="$UI_VALUE"
         ui_confirm "Post comment to $wk?" no \
           && run_action cmd_work_comment --key "$wk" --text "$wt" --apply
         pause ;;
      4) ui_text "Work item key" "" || continue
         local sk="$UI_VALUE"
         ui_text "Target status (must match exactly)" "" || continue
         local st="$UI_VALUE"
         run_action cmd_work_status --key "$sk" --to "$st"
         ui_confirm "Change status $sk → $st?" no \
           && run_action cmd_work_status --key "$sk" --to "$st" --apply
         pause ;;
      5) menu_work_project ;;
      6) run_action cmd_work_types; pause ;;
      7) ui_text "Project names you expect to exist (comma, empty = skip)" "" \
           && run_action cmd_work_doctor --expect "$UI_VALUE" \
           || run_action cmd_work_doctor
         pause ;;
      8) ui_text "Project UUID (from the URL in the UI)" "" || continue
         run_action cmd_work_project_access --id "$UI_VALUE"; pause ;;
      9) return 0 ;;
    esac
  done
}

# The project is picked from the API response, so a UUID never has to be typed
# or pasted - which is where the last round of input bugs came from.
menu_work_project() {
  need_auth
  local json; json="$(cases_projects_fetch)" || { pause; return 0; }
  local n; n="$(printf '%s' "$json" | jq -r 'length')"
  if [ "${n:-0}" -eq 0 ]; then
    warn "No projects readable. Run Doctor to find out why."
    pause; return 0
  fi
  local labels=() ids=() line pid pkey pname prest
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    IFS=$'\x1f' read -r pid pkey pname prest <<< "${line//$'\t'/$'\x1f'}"
    ids+=("$pid")
    labels+=("$(printf '%-12s %-32.32s restricted=%s' "$pkey" "$pname" "$prest")")
  done <<EOF
$(printf '%s' "$json" | jq -r 'sort_by(.attributes.name // "") | .[]
  | "\(.id)\t\(.attributes.key // "?")\t\(.attributes.name // "?")\t\((.attributes.restricted // false)|tostring)"')
EOF
  labels+=("← Cancel")
  ui_select "Select active project ($n readable)" "${labels[@]}" || return 0
  [ "$UI_INDEX" -lt "$n" ] || return 0
  run_action cmd_work_use_project --id "${ids[$UI_INDEX]}"
  pause
}

menu_session() {
  while :; do
    ui_select "Session" \
      "Status" \
      "Login / change credentials" \
      "Probe permissions (all features)" \
      "Logout (delete local credentials)" \
      "← Back" || return 0
    case "$UI_INDEX" in
      0) run_action cmd_auth_status; pause ;;
      1) run_action cmd_auth_login; pause ;;
      2) run_action cmd_auth_probe; pause ;;
      3) ui_confirm "Delete local credentials?" no && run_action cmd_auth_logout; pause ;;
      4) return 0 ;;
    esac
  done
}

menu_report() {
  local ext fmt
  ui_select "Report format" \
    "Markdown (.md)" \
    "HTML (.html)" \
    "JSON (.json)" \
    "← Cancel" || return 0
  case "$UI_INDEX" in
    0) fmt=md;   ext=md ;;
    1) fmt=html; ext=html ;;
    2) fmt=json; ext=json ;;
    *) return 0 ;;
  esac

  ui_text "Findings query" '@status:open' || return 0
  local q="$UI_VALUE"
  local args=(--format "$fmt" --query "$q")

  ui_select "Destination" "Save to file" "Print to screen" "← Cancel" || return 0
  case "$UI_INDEX" in
    0) ui_text "Output file" "posture-report.$ext" || return 0; args+=(--out "$UI_VALUE") ;;
    1) : ;;
    *) return 0 ;;
  esac

  run_action cmd_report "${args[@]}"
  pause
}

cmd_start() {
  MENU_MODE=true
  while :; do
    banner
    ui_select "Main menu" \
      "Findings - list, filter, SAST violations" \
      "Recast severity - pick / bulk / rule / mute" \
      "Work Management - work items, comments, status" \
      "Report - generate posture report (md/html/json)" \
      "Session - login, status, permission probe" \
      "Help" \
      "Quit" || { info ""; ok "Bye"; return 0; }
    case "$UI_INDEX" in
      0) menu_findings ;;
      1) menu_recast ;;
      2) menu_work ;;
      3) menu_report ;;
      4) menu_session ;;
      5) usage; pause ;;
      6) info ""; ok "Bye"; return 0 ;;
    esac
  done
}

usage() {
  cat >&2 <<'EOF'
dd-sec - Datadog Security CLI (pure bash)

  dd-sec start        interactive menu (↑/↓ move, Enter select, q cancel);
                      authentication is requested when needed

FINDINGS
  findings list   [--query Q] [--limit N] [--json] [--export FILE.tsv]
                  Results are NUMBERED and cached, so the next action uses
                  the number, not the finding ID.
  findings show N                    detail of row #N, including the full ID
  findings keys   [--query Q]        show the real attribute layout;
                                     use this if columns come out as "-"
  sast list       [--repo NAME] [--repo-id HOST/PATH] [--branch B] [--sha SHA]
                  [--from-git] [--all-categories]
    No filter = org-wide. --repo tries @git.repository.name then automatically
    falls back to a wildcard @git.repository.id:*NAME*, because repository.name
    is not confirmed as a facet on the cicodescan track.
  sast list ... [--days D]           lookback; default 30 days
  sast repos      [DAYS]             repo identifiers PRESENT in the data (default 90d)
  sast probe      [--repo N|--repo-id ID] [--branch B] [--days D]
    Adds filters one at a time, printing the result count at each step. The
    first one to become 0 is the cause. Use this when the result is 0.

RECAST  (needs severity_mode=direct; check with auth probe)
  recast pick     --select S --to SEV --reason R [--apply]
    S = 3 | 1,4,9 | 2-10 | all | all,!7   (numbers from findings list)
    This is the primary path: no ID to copy. Before apply, the selection
    is re-verified against live data and shown by NAME.
  recast one      --id ID --to SEV --reason R [--apply]
  recast query    --query Q --to SEV --reason R [--limit N] [--apply]
  recast bulk     --file F.csv|F.json [--apply]

MUTE
  mute pick       --select S --reason R [--unmute] [--apply]
  mute            (--id ID | --query Q) --reason R [--unmute] [--apply]
    mute   : PENDING_FIX FALSE_POSITIVE OTHER NO_FIX DUPLICATE RISK_ACCEPTED
    unmute : NO_PENDING_FIX HUMAN_ERROR NO_LONGER_ACCEPTED_RISK OTHER

RULES  (severity modifier rules API; always key-auth)
  rule list
  rule create     --name N (--to SEV | --shift up|down) --types T[,T]
                  [--query Q] --reason R [--apply]
  rule delete     --id RULE_ID [--apply]

WORK MANAGEMENT
  work list       [--filter F] [--limit N]
  work view       --key KEY
  work comment    --key KEY --text T [--apply]
  work status     --key KEY --to STATUS [--apply]
  work projects | work types | work use-project --id ID
  work project-access --id UUID      read one project's restriction policy,
                                     including projects that do not appear in the list
                                     (take the UUID from the project URL in the UI)
  work doctor     [--expect 'name1,name2']
    Why the API returns fewer projects than the dashboard.
    Checks app key identity, key scope, pagination, and restriction policy
    per project.

REPORT  (read-only; needs only *_read permissions)
  report          [--query Q] [--days D] [--format md|html|json] [--out FILE]
                  [--title T] [--top N] [--limit N] [--no-sast]
    Point-in-time posture report: findings severity distribution, top findings,
    and (when code_analysis_read is present) a SAST summary with top repos.
    Markdown by default; HTML is a self-contained styled page; JSON is a
    machine-readable summary. Writes to stdout unless --out is given.
      report --format html --out posture.html
      report --query '@status:open @severity:(high OR critical)' --days 90

SESSION
  auth login      [--mode browser|manual|env] [--site S] [--api-key K] [--app-key K]
  auth status | auth probe | auth logout

SEVERITY   info_none | low | medium | high | critical
  Floor per finding type: static_code_vulnerability, secret,
  iac_misconfiguration and runtime_code_vulnerability do not support
  info_none (floor-nya low).

DRY-RUN DEFAULT
  All data-changing actions default to dry-run. --apply is required.
  --reason is also required on every write: a recast without justification is an audit finding.

FILE FORMAT (recast bulk)
  TSV   from `findings list --export`. Header-mapped; extra columns
        (current_severity, name, resource) carried for review and ignored.
        an EMPTY target_severity = row skipped, no need to delete it.
  CSV   finding_id,target_severity,reason     (positional; reason may contain commas)
  JSON  [{"finding_id":"...","target_severity":"high","reason":"..."}]

ENV
  DD_API_KEY DD_APP_KEY DD_SITE
  DD_CASES_PROJECT_ID   default Work Management project
  DD_SEC_HOME           override config dir
  DD_SEC_KEYSTORE       auto|keychain|secret|file
  DD_SEC_NO_TUI         set to anything to disable the arrow-key menu and
                        use numbered prompts (automatic when not a TTY)
  SAST_QUERY_LIMIT      default 5000; the cicodescan endpoint is undocumented,
                        the server ceiling is not guaranteed stable
  SAST_LOOKBACK_DAYS    default 30
  NO_COLOR
EOF
}

# -----------------------------------------------------------------------------
need_deps
[ $# -gt 0 ] || { cmd_start; exit 0; }

group="$1"; shift
case "$group" in
  start|menu|"") cmd_start ;;
  auth)
    sub="${1:-status}"; [ $# -gt 0 ] && shift
    case "$sub" in
      login) cmd_auth_login "$@" ;; status) cmd_auth_status "$@" ;;
      logout) cmd_auth_logout "$@" ;; probe) cmd_auth_probe "$@" ;;
      *) die "auth: unknown subcommand '$sub'" ;;
    esac ;;
  findings)
    sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
      list) cmd_findings_list "$@" ;;
      show) cmd_findings_show "$@" ;;
      keys) cmd_findings_keys "$@" ;;
      *) die "findings: use list|show|keys" ;;
    esac ;;
  sast)
    sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
      list)  cmd_sast_list "$@" ;;
      repos) cmd_sast_repos "$@" ;;
      probe) cmd_sast_probe "$@" ;;
      *) die "sast: use list|repos|probe" ;;
    esac ;;
  recast)
    sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
      pick) cmd_recast_pick "$@" ;;
      one) cmd_recast_one "$@" ;; query) cmd_recast_query "$@" ;;
      bulk) cmd_recast_bulk "$@" ;;
      *) die "recast: use pick|one|query|bulk" ;;
    esac ;;
  mute)
    if [ "${1:-}" = "pick" ]; then shift; cmd_mute_pick "$@"; else cmd_mute "$@"; fi ;;
  rule)
    sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
      list) cmd_rule_list "$@" ;; create) cmd_rule_create "$@" ;;
      delete) cmd_rule_delete "$@" ;; *) die "rule: use list|create|delete" ;;
    esac ;;
  work)
    sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
      list) cmd_work_list "$@" ;; view) cmd_work_view "$@" ;;
      comment) cmd_work_comment "$@" ;; status) cmd_work_status "$@" ;;
      projects) cmd_work_projects "$@" ;; types) cmd_work_types "$@" ;;
      use-project) cmd_work_use_project "$@" ;;
      doctor) cmd_work_doctor "$@" ;;
      project-access) cmd_work_project_access "$@" ;;
      *) die "work: use list|view|comment|status|projects|types|use-project|doctor|project-access" ;;
    esac ;;
  report) cmd_report "$@" ;;
  version|--version|-v) printf 'dd-sec %s\n' "$VERSION" ;;
  help|--help|-h) usage ;;
  *) die "Unknown command '$group'. See: $PROG help" ;;
esac

cmd_work_status() {
  need_auth
  local key="" status="" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --key) key="$2"; shift 2 ;; --to) status="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$key" ] || die "--key required"
  [ -n "$status" ] || die "--to required (status name, must match exactly including spaces)"

  dd_req_retry GET "/api/v2/cases?filter=$(urlencode "$key")&page%5Bsize%5D=50" \
    || { explain_http; return 1; }
  local cid cur
  cid="$(printf '%s' "$HTTP_BODY" | jq -r --arg k "$key" '[.data[]?|select((.attributes.key//"")==$k)|.id][0] // empty')"
  cur="$(printf '%s' "$HTTP_BODY" | jq -r --arg k "$key" '[.data[]?|select((.attributes.key//"")==$k)|.attributes.status_name][0] // ""')"
  [ -n "$cid" ] || die "Work item '$key' not found."

  info "  $key: ${cur:-?} → $status"
  [ "$apply" -eq 1 ] || { warn "DRY-RUN. Tambahkan --apply."; return 0; }

  if dd_req_retry POST "/api/v2/cases/$cid/status" \
       "$(jq -nc --arg s "$status" '{data:{attributes:{status_name:$s},type:"case"}}')"; then
    ok "Status of $key changed to '$status'"
    audit_log case "$key" "status=$status" "from:${cur:-?}" "$HTTP_CODE"
  else
    explain_http
    dim "  Two causes cover almost every failure here:"
    dim "    1. this item's work type has no status named '$status'."
    dim "       The status name must match exactly, including spaces and case."
    dim "    2. the project restricts status transitions, and the identity behind the app"
    dim "       key is not allowed to make this transition."
    return 1
  fi
}

# -----------------------------------------------------------------------------
# SAST violations (cicodescan track)
#
# SCOPE IS OPTIONAL. The query works with no repository filter at all, which is
# the org-wide view; a repo or a branch only narrows it. Requiring a repo id up
# front was wrong: most triage starts from "what is broken anywhere", and a
# branch name alone is a perfectly good filter.
#
# REPO NAME VS REPO ID. These are different fields and mixing them returns
# nothing at all, silently:
#   @git.repository.name  the bare name, e.g. vulnerable-java-app
#   @git.repository.id    host plus path, e.g. gitlab.example.com/team/app
# The value is routed by shape - a "/" means an id, otherwise a name - and the
# field that was actually used is printed, so a zero result can be told apart
# from a wrong field.
# -----------------------------------------------------------------------------
repo_id_from_git() {
  local url
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  [ -n "$url" ] || return 1
  url="${url#git@}"; url="${url#http://}"; url="${url#https://}"
  url="${url%.git}"; url="${url/://}"
  printf '%s' "${url%/}"
}

cmd_sast_list() {
  need_auth
  local repo="" repo_id="" sha="" branch="" show_all=0 use_git=0 scope_desc=""
  local _lb_prev="$SAST_LOOKBACK_DAYS"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)    repo="$2"; shift 2 ;;
      --repo-id) repo_id="$2"; shift 2 ;;
      --branch)  branch="$2"; shift 2 ;;
      --sha)     sha="$2"; shift 2 ;;
      --days)    SAST_LOOKBACK_DAYS="$2"; shift 2 ;;
      --from-git) use_git=1; shift ;;
      --all-categories) show_all=1; shift ;;
      *) SAST_LOOKBACK_DAYS="$_lb_prev"; die "Unknown argument: $1" ;;
    esac
  done
  case "$SAST_LOOKBACK_DAYS" in
    ''|*[!0-9]*) SAST_LOOKBACK_DAYS="$_lb_prev"; die "--days must be a number" ;;
  esac

  if [ "$use_git" -eq 1 ] && [ -z "$repo" ] && [ -z "$repo_id" ]; then
    repo_id="$(repo_id_from_git)" || die "No git remote in this directory."
    dim "  repo-id from git remote: $repo_id"
  fi

  # A bare value handed to --repo that looks like an id is routed to the id
  # field rather than failing quietly against the name field.
  if [ -n "$repo" ] && [ -z "$repo_id" ]; then
    case "$repo" in
      */*) repo_id="$repo"; repo=""
           dim "  '$repo_id' contains '/', used as @git.repository.id" ;;
    esac
  fi

  # PASTE-SHIFT GUARD. If --branch received something shaped like a repository
  # identifier (a dotted host followed by a path), the value went into the wrong
  # field - which is exactly what happens when a pasted value carries a leading
  # newline and lands in the next prompt. Silently querying
  # @git.branch:host/path returns zero and looks like "no violations".
  if [ -n "$branch" ] && printf '%s' "$branch" | grep -Eq '^[A-Za-z0-9._-]+\.[A-Za-z]{2,}/'; then
    warn "'$branch' looks like host+path, not a branch name."
    if [ -z "$repo" ] && [ -z "$repo_id" ]; then
      step "Used as --repo-id, and the branch filter is cleared."
      dim "  This usually happens when a pasted value carries a leading newline,"
      dim "  so it lands in the next prompt."
      repo_id="$branch"; branch=""
    else
      dim "  The repo filter is already set, so this value is still used as a branch."
      dim "  If that is not what you meant, re-run without --branch."
    fi
  fi

  local q="@static_analysis.result.item_type:static_analysis_violation -@static_analysis.result.is_suppressed:true -@static_analysis.rule.is_testing:true"
  [ -z "$repo_id" ] || { q="$q @git.repository.id:${repo_id}"; scope_desc="repo.id=${repo_id}"; }
  [ -z "$repo" ]    || { q="$q @git.repository.name:${repo}"; scope_desc="repo.name=${repo}"; }
  [ -z "$branch" ]  || { q="$q @git.branch:${branch}"; scope_desc="${scope_desc:+$scope_desc }branch=${branch}"; }
  [ -z "$sha" ]     || { q="$q @git.commit.sha:${sha}"; scope_desc="${scope_desc:+$scope_desc }sha=${sha:0:8}"; }
  [ "$show_all" -eq 1 ] || q="$q @static_analysis.result.category:security"

  step "cicodescan: ${scope_desc:-ALL repos (org-wide)}"
  [ "$show_all" -eq 0 ] || dim "  Including all categories, not just security."

  local out; out="$(mktemp)"
  dd_cicodescan "$q" "$out" true || { rm -f "$out"; return 1; }

  local n; n="$(jq -r '.result.events | length' "$out")"

  # @git.repository.name is NOT confirmed to be a facet on the cicodescan
  # track - the only field the working SAST gate ever used is
  # @git.repository.id. A filter on a non-facet field returns zero rows with no
  # error, which looks exactly like "no violations". So a name that finds
  # nothing is retried as a wildcard against the id, which usually matches
  # because the id ends with the repository name.
  if [ "$n" -eq 0 ] && [ -n "$repo" ]; then
    warn "0 results with @git.repository.name:${repo}"
    step "Retrying as @git.repository.id:*${repo}* (wildcard)..."
    local q2="${q// @git.repository.name:${repo}/ @git.repository.id:*${repo}*}"
    if dd_cicodescan "$q2" "$out" true; then
      n="$(jq -r '.result.events | length' "$out")"
      if [ "$n" -gt 0 ]; then
        ok "Found $n violations via a wildcard on repository.id."
        dim "  So @git.repository.name really is not a field on this track."
        dim "  The correct repository.id value:"
        jq -r '[.result.events[]?.event.custom?.git?.repository?.id?
                | select(type=="string" and . != "")] | unique | .[]' "$out" 2>/dev/null \
          | sed 's/^/    /' >&2
        scope_desc="repo.id=*${repo}* (wildcard)"
      fi
    fi
  fi

  if [ "$n" -eq 0 ]; then
    warn "0 violations in the last ${SAST_LOOKBACK_DAYS} days."
    dim "  Zero violations does NOT mean clean code, and guessing which filter"
    dim "  is wrong among those five ANDed filters is futile. Just measure:"
    dim ""
    if [ -n "$repo" ]; then
      dim "    $PROG sast probe --repo '$repo' --days 90"
    elif [ -n "$repo_id" ]; then
      dim "    $PROG sast probe --repo-id '$repo_id' --days 90"
    else
      dim "    $PROG sast probe --days 90"
    fi
    dim ""
    dim "  It adds filters one at a time and prints the result count at each"
    dim "  step. The first line that becomes 0 is the cause."
    dim "  To see the repo identifiers that actually exist in the data:"
    dim "    $PROG sast repos"
    dim ""
    dim "  Note also the LAST SCAN DATE in the Code Security UI. The"
    dim "  cicodescan track only stores events for scans inside the time window,"
    dim "  so a repo last scanned longer ago than ${SAST_LOOKBACK_DAYS} days"
    dim "  reads as zero even if its findings still show in the UI."
    dim "    $PROG sast list --days 90 ..."
    rm -f "$out"; SAST_LOOKBACK_DAYS="$_lb_prev"; return 0
  fi

  hdr "$n violation"
  jq -r '
    .result.events[]?
    | (.event.custom.static_analysis // {}) as $sa
    | ($sa.result // {}) as $r | ($sa.rule // {}) as $rule
    | [ ($r.k9_severity? // ""), ($rule.id? // "?"),
        ($r.source?.file? // "?"), ($r.source?.start_line? // 0 | tostring),
        ($r.message? // "" | gsub("[\t\n]"; " ")),
        (.event.custom?.git?.repository?.name?
         // .event.custom?.git?.repository?.id? // "") ] | @tsv' "$out" \
    | awk -F'\t' 'BEGIN{OFS="\t"}
        { s=tolower($1); rk=7
          if      (s=="critical") rk=1
          else if (s=="high")     rk=2
          else if (s=="medium")   rk=3
          else if (s=="low")      rk=4
          else if (s=="info"||s=="notice") rk=5
          else if (s=="")         rk=6
          print rk, $0 }' \
    | sort -t"$(printf '\t')" -k1,1n -s | cut -f2- \
    | awk -F'\t' '{
        sev = ($1 == "" ? "-" : toupper($1))
        printf "  %-9s %-32.32s %s:%s\n", sev, $2, $3, $4
        if ($6 != "") printf "             %s\n", $6
        printf "             %.72s\n", $5 }' >&2

  info ""
  jq -r '[.result.events[]?.event.custom?.static_analysis?.result?.k9_severity? // "unknown"]
         | group_by(.) | map("\(.[0])=\(length)") | join("  ")' "$out" \
    | sed 's/^/  Distribution: /' >&2
  # Only meaningful without a repo filter, where the org-wide spread is the point.
  if [ -z "$repo" ] && [ -z "$repo_id" ]; then
    jq -r '[.result.events[]?.event.custom?.git?.repository?.name? // "?"]
           | group_by(.) | map({r:.[0], n:length}) | sort_by(-.n) | .[0:8]
           | map("\(.r)=\(.n)") | join("  ")' "$out" 2>/dev/null \
      | sed 's/^/  Top repo  : /' >&2
  fi
  rm -f "$out"; SAST_LOOKBACK_DAYS="$_lb_prev"
}

# Lists the repository identifiers that ACTUALLY exist on the cicodescan track.
#
# This exists because `@git.repository.name` was a guess. The only field the
# working SAST gate ever used is `@git.repository.id`, and a filter on a field
# that is not a facet on this track returns zero rows with no error - which is
# indistinguishable from "no violations". Rather than guess again, read the
# identifiers out of the data and let the person pick one verbatim.
cmd_sast_repos() {
  need_auth
  local days="${1:-90}"
  local prev="$SAST_LOOKBACK_DAYS"
  SAST_LOOKBACK_DAYS="$days"

  step "Collecting repo identifiers from the cicodescan track (${days} days)..."
  local out; out="$(mktemp)"
  # Non-strict: only the set of identifiers matters, not a complete row count.
  if ! dd_cicodescan '@static_analysis.result.item_type:static_analysis_violation' "$out" false; then
    SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"; return 1
  fi

  local n; n="$(jq -r '.result.events | length' "$out")"
  if [ "$n" -eq 0 ]; then
    warn "0 events on the cicodescan track in ${days} days."
    dim "  This means it is not a wrong repo filter - there simply is no SAST data"
    dim "  reaching this track. Check:"
    dim "    - Is Code Security enabled for those repos in Datadog?"
    dim "    - Does the app key have code_analysis_read? ($PROG auth probe)"
    dim "    - Correct site? Currently: ${DD_SITE_R}"
    SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"; return 0
  fi

  hdr "Repo identifiers present in the data ($n events inspected)"
  info "  Use the values below AS-IS."
  info ""
  printf '  %-14s %s\n' "FIELD" "VALUE (event count)" >&2
  jq -r '
    [ .result.events[]? | .event.custom?.git? // {} ]
    | ( [ .[] | .repository?.id?  | select(type=="string" and . != "") ] ) as $ids
    | ( [ .[] | .repository?.name? | select(type=="string" and . != "") ] ) as $names
    | ( [ .[] | .branch?          | select(type=="string" and . != "") ] ) as $brs
    | ( ($ids   | group_by(.) | map("repository.id\u0009\(.[0])  (\(length))"))
      + ($names | group_by(.) | map("repository.name\u0009\(.[0])  (\(length))"))
      + ($brs   | group_by(.) | map("branch\u0009\(.[0])  (\(length))")) )
    | .[]' "$out" \
    | awk -F'\t' '{ printf "  %-14s %s\n", $1, $2 }' >&2

  info ""
  dim "  If a 'repository.name' row does NOT appear at all, that field is not"
  dim "  present on this track - use --repo-id with a repository.id value above."
  dim "  Example:"
  local sample
  sample="$(jq -r '[.result.events[]?.event.custom?.git?.repository?.id? | select(type=="string" and . != "")][0] // ""' "$out")"
  [ -z "$sample" ] || dim "    $PROG sast list --repo-id '$sample'"
  SAST_LOOKBACK_DAYS="$prev"; rm -f "$out"
}

# Runs the query with filters added ONE AT A TIME and prints the count after
# each. The step where the count drops to zero is the filter that is wrong.
#
# This is the whole diagnosis for "0 violation but there should be some":
# guessing which of five ANDed filters is at fault is hopeless, measuring is
# trivial.
cmd_sast_probe() {
  need_auth
  local repo="" repo_id="" branch="" days="${SAST_LOOKBACK_DAYS}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --repo-id) repo_id="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --days) days="$2"; shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  local prev="$SAST_LOOKBACK_DAYS"; SAST_LOOKBACK_DAYS="$days"

  hdr "Filter ladder - lookback ${days} days"
  dim "  Each line adds ONE filter. The first line that becomes 0 is"
  dim "  the cause."
  info ""

  local q="" out zero_at=""
  out="$(mktemp)"

  _probe_step() { # label added_filter
    local label="$1" add="$2" n
    q="${q:+$q }$add"
    if dd_cicodescan "$q" "$out" false >/dev/null 2>&1; then
      n="$(jq -r '.result.events | length' "$out")"
    else
      n="ERR"
    fi
    if [ "$n" = "ERR" ]; then
      printf '  %s✗%s %-44s query failed\n' "$C_RED" "$C_OFF" "$label" >&2
    elif [ "$n" = "0" ]; then
      printf '  %s✗%s %-44s 0\n' "$C_RED" "$C_OFF" "$label" >&2
      [ -n "$zero_at" ] || zero_at="$label"
    else
      printf '  %s✓%s %-44s %s\n' "$C_GRN" "$C_OFF" "$label" "$n" >&2
    fi
  }

  _probe_step "item_type:static_analysis_violation" \
    "@static_analysis.result.item_type:static_analysis_violation"
  _probe_step "+ not suppressed" "-@static_analysis.result.is_suppressed:true"
  _probe_step "+ not a testing rule" "-@static_analysis.rule.is_testing:true"

  if [ -n "$repo_id" ]; then
    _probe_step "+ repository.id:$repo_id" "@git.repository.id:${repo_id}"
  fi
  if [ -n "$repo" ]; then
    _probe_step "+ repository.name:$repo" "@git.repository.name:${repo}"
    # A name that is not a facet returns nothing; a wildcard against the id is
    # the fallback that usually does match, since the id ends with the name.
    local qsave="$q"
    q="${q% @git.repository.name:${repo}}"
    _probe_step "+ repository.id:*${repo}* (wildcard)" "@git.repository.id:*${repo}*"
    [ "$(jq -r '.result.events | length' "$out" 2>/dev/null || echo 0)" != "0" ] || q="$qsave"
  fi
  [ -z "$branch" ] || _probe_step "+ branch:$branch" "@git.branch:${branch}"
  _probe_step "+ category:security" "@static_analysis.result.category:security"

  info ""
  if [ -n "$zero_at" ]; then
    warn "The filter that kills the result: $zero_at"
    case "$zero_at" in
      *repository.name*)
        dim "  @git.repository.name appears NOT to be a field on the cicodescan track."
        dim "  Use --repo-id. See valid values:"
        dim "    $PROG sast repos" ;;
      *repository.id*)
        dim "  The repository.id value does not match. It is the full host+path,"
        dim "  e.g. gitlab.example.com/team/app. See what is in the data:"
        dim "    $PROG sast repos" ;;
      *branch*)
        dim "  The branch name does not match, or that branch was never scanned." ;;
      *category*)
        dim "  There are violations, but NONE are security category - all"
        dim "  code_style or other categories. That proves the scan landed."
        dim "  Lihat semuanya: $PROG sast list --all-categories" ;;
      *item_type*)
        dim "  No SAST events at all in the last ${days} days."
        dim "  Raise --days, or check code_analysis_read and DD_SITE." ;;
      *) dim "  See what actually exists in the data: $PROG sast repos" ;;
    esac
  else
    ok "All filters pass - the full query returns results."
    dim "  If 'sast list' is still 0, report it: that means a bug in this tool."
  fi
  rm -f "$out"; SAST_LOOKBACK_DAYS="$prev"
}

# -----------------------------------------------------------------------------
# report  -  posture report generator  (BETA)
#
# Pulls the same data the interactive views show - security findings and, when
# the app key allows it, SAST (cicodescan) violations - and renders ONE
# point-in-time report in Markdown (default), self-contained HTML, or JSON.
#
# READ-ONLY by construction. report never mutates a finding; it needs only the
# *_read permissions. A section whose permission is missing is marked
# "unavailable" in the output rather than aborting the whole run - a partial
# report is more useful than none, as long as it says what is partial.
#
#   dd-sec report                                  # Markdown to stdout
#   dd-sec report --format html --out posture.html
#   dd-sec report --query '@status:open @severity:(high OR critical)' --days 90
# -----------------------------------------------------------------------------
_rep_md_cell() { printf '%s' "$1" | tr '\n\t' '  ' | sed 's/|/\\|/g'; }
_rep_html_esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
_rep_up() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

cmd_report() {
  need_auth
  local query='@status:open' days="$SAST_LOOKBACK_DAYS" fmt="md" out="" title=""
  local topn=25 max=1000 do_sast=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --query)   query="$2"; shift 2 ;;
      --days)    days="$2"; shift 2 ;;
      --format)  fmt="$2"; shift 2 ;;
      --out)     out="$2"; shift 2 ;;
      --title)   title="$2"; shift 2 ;;
      --top)     topn="$2"; shift 2 ;;
      --limit)   max="$2"; shift 2 ;;
      --no-sast) do_sast=0; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  case "$fmt"  in md|html|json) : ;; *) die "--format must be md|html|json" ;; esac
  case "$days" in ''|*[!0-9]*) die "--days must be a number" ;; esac
  case "$topn" in ''|*[!0-9]*) die "--top must be a number" ;; esac
  case "$max"  in ''|*[!0-9]*) die "--limit must be a number" ;; esac
  [ -n "$title" ] || title="Datadog Security Posture Report"

  local genat; genat="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # --- findings (the one section that must succeed) --------------------------
  step "Collecting security findings (query: $query)"
  local ftsv; ftsv="$(mktemp)"
  findings_fetch "$query" "$max" > "$ftsv" || { rm -f "$ftsv"; die "Failed to fetch findings. Check: $PROG auth probe"; }

  local F_TOT=0 F_CRIT=0 F_HIGH=0 F_MED=0 F_LOW=0 F_INFO=0 F_UNK=0
  eval "$(awk -F'\t' '
    { tot++; s=tolower($2)
      if      (s=="critical") c++
      else if (s=="high")     h++
      else if (s=="medium")   m++
      else if (s=="low")      l++
      else if (s=="info"||s=="none"||s=="info_none") i++
      else u++ }
    END { printf "F_TOT=%d;F_CRIT=%d;F_HIGH=%d;F_MED=%d;F_LOW=%d;F_INFO=%d;F_UNK=%d\n",
          tot+0,c+0,h+0,m+0,l+0,i+0,u+0 }' "$ftsv")"

  # status breakdown, most common first
  local fstatus; fstatus="$(mktemp)"
  awk -F'\t' '{ s=$3; if (s=="") s="(none)"; cnt[s]++ }
    END { for (k in cnt) printf "%d\t%s\n", cnt[k], k }' "$ftsv" \
    | sort -rn > "$fstatus"

  # top findings, severity-ranked, capped at --top
  local ftop; ftop="$(mktemp)"
  awk -F'\t' 'BEGIN{OFS="\t"}
    { s=tolower($2); r=7
      if      (s=="critical") r=1
      else if (s=="high")     r=2
      else if (s=="medium")   r=3
      else if (s=="low")      r=4
      else if (s=="info"||s=="none"||s=="info_none") r=5
      else if (s=="")         r=6
      print r, $0 }' "$ftsv" \
    | sort -t"$(printf '\t')" -k1,1n -s | cut -f2- | head -n "$topn" > "$ftop"

  # --- SAST (optional, degrades to "unavailable") ----------------------------
  local S_TOT=0 S_CRIT=0 S_HIGH=0 S_MED=0 S_LOW=0 S_INFO=0 sast_ok=0
  local stops; stops="$(mktemp)"; : > "$stops"
  if [ "$do_sast" -eq 1 ]; then
    step "Collecting SAST violations (cicodescan, ${days}-day lookback)"
    local _prev="$SAST_LOOKBACK_DAYS"; SAST_LOOKBACK_DAYS="$days"
    local sout; sout="$(mktemp)"
    local sq='@static_analysis.result.item_type:static_analysis_violation -@static_analysis.result.is_suppressed:true -@static_analysis.rule.is_testing:true @static_analysis.result.category:security'
    if dd_cicodescan "$sq" "$sout" false >/dev/null 2>&1; then
      sast_ok=1
      eval "$(jq -r '
        [ .result.events[]? | .event.custom?.static_analysis?.result?.k9_severity? // "unknown" | ascii_downcase ] as $s
        | "S_TOT=\($s|length)"
        + ";S_CRIT=\($s|map(select(.==\"critical\"))|length)"
        + ";S_HIGH=\($s|map(select(.==\"high\"))|length)"
        + ";S_MED=\($s|map(select(.==\"medium\"))|length)"
        + ";S_LOW=\($s|map(select(.==\"low\"))|length)"
        + ";S_INFO=\($s|map(select(.==\"info\" or .==\"notice\"))|length)"
      ' "$sout" 2>/dev/null)"
      jq -r '
        [ .result.events[]? | .event.custom?.git?.repository?.name?
          // .event.custom?.git?.repository?.id? // "?" ]
        | group_by(.) | map({r:.[0], n:length}) | sort_by(-.n) | .[0:10]
        | .[] | "\(.n)\t\(.r)"' "$sout" 2>/dev/null > "$stops"
    else
      warn "SAST section unavailable (missing code_analysis_read / endpoint error) - continuing without it."
    fi
    rm -f "$sout"; SAST_LOOKBACK_DAYS="$_prev"
  fi

  # --- render ----------------------------------------------------------------
  local rep; rep="$(mktemp)"
  local beta='dd-sec is in BETA testing. Treat this report as advisory: verify findings in the Datadog UI before acting on them. The SAST section reads an undocumented endpoint whose result ceiling is not guaranteed.'

  if [ "$fmt" = "json" ]; then
    jq -n \
      --arg title "$title" --arg org "${ORG_NAME:-}" --arg site "${DD_SITE_R:-}" \
      --arg gen "$genat" --arg query "$query" --arg ver "$VERSION" --arg beta "$beta" \
      --argjson days "$days" \
      --argjson ftot "$F_TOT" --argjson fcrit "$F_CRIT" --argjson fhigh "$F_HIGH" \
      --argjson fmed "$F_MED" --argjson flow "$F_LOW" --argjson finfo "$F_INFO" --argjson funk "$F_UNK" \
      --argjson sastok "$sast_ok" --argjson stot "$S_TOT" --argjson scrit "$S_CRIT" \
      --argjson shigh "$S_HIGH" --argjson smed "$S_MED" --argjson slow "$S_LOW" --argjson sinfo "$S_INFO" \
      --rawfile ftop "$ftop" --rawfile stops "$stops" --rawfile fstatus "$fstatus" \
      '{
        meta: { title:$title, generated_utc:$gen, tool:"dd-sec", version:$ver,
                beta_notice:$beta, organization:$org, site:$site,
                findings_query:$query, sast_lookback_days:$days },
        findings: {
          total:$ftot,
          by_severity: { critical:$fcrit, high:$fhigh, medium:$fmed, low:$flow, info:$finfo, unknown:$funk },
          by_status: ( $fstatus | split("\n") | map(select(length>0)) | map(split("\t"))
                       | map({ status:.[1], count:(.[0]|tonumber) }) ),
          top: ( $ftop | split("\n") | map(select(length>0)) | map(split("\t"))
                 | map({ id:.[0], severity:.[1], status:.[2], title:.[3], resource:.[4] }) )
        },
        sast: {
          available:($sastok==1),
          total:$stot,
          by_severity: { critical:$scrit, high:$shigh, medium:$smed, low:$slow, info:$sinfo },
          top_repositories: ( $stops | split("\n") | map(select(length>0)) | map(split("\t"))
                              | map({ repository:.[1], violations:(.[0]|tonumber) }) )
        }
      }' > "$rep"

  elif [ "$fmt" = "html" ]; then
    {
      cat <<HTMLHEAD
<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$(_rep_html_esc "$title")</title>
<style>
  :root { --bg:#fff; --fg:#1b1f24; --muted:#5a6572; --line:#e4e8ec; --card:#f7f9fb;
          --crit:#b31515; --high:#e8640c; --med:#c99700; --low:#2f7d32; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0e1116; --fg:#e6edf3; --muted:#9aa5b1; --line:#242b33; --card:#161b22; } }
  * { box-sizing:border-box; }
  body { margin:0; padding:2rem 1rem; background:var(--bg); color:var(--fg);
         font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
  main { max-width:900px; margin:0 auto; }
  h1 { font-size:1.6rem; margin:0 0 .25rem; }
  h2 { font-size:1.2rem; margin:2rem 0 .75rem; border-bottom:1px solid var(--line); padding-bottom:.3rem; }
  h3 { font-size:1rem; margin:1.3rem 0 .5rem; }
  .beta { background:var(--card); border:1px solid var(--line); border-left:3px solid var(--high);
          padding:.6rem .9rem; border-radius:6px; color:var(--muted); font-size:.9rem; margin:1rem 0 1.5rem; }
  table { border-collapse:collapse; width:100%; margin:.5rem 0 1rem; font-size:.92rem; }
  th,td { text-align:left; padding:.45rem .6rem; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-weight:600; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; }
  .meta td:first-child { color:var(--muted); width:11rem; }
  .chip { display:inline-block; padding:.08rem .5rem; border-radius:999px; font-size:.78rem;
          font-weight:700; color:#fff; }
  .CRITICAL{background:var(--crit);} .HIGH{background:var(--high);} .MEDIUM{background:var(--med);}
  .LOW{background:var(--low);} .INFO{background:var(--muted);} .UNKNOWN{background:var(--muted);}
  code { background:var(--card); padding:.1rem .35rem; border-radius:4px; font-size:.85em; }
  .cards { display:flex; flex-wrap:wrap; gap:.6rem; margin:.5rem 0 1rem; }
  .card { flex:1 1 7rem; background:var(--card); border:1px solid var(--line); border-radius:8px; padding:.7rem .9rem; }
  .card .n { font-size:1.5rem; font-weight:700; } .card .l { color:var(--muted); font-size:.8rem; }
  footer { margin-top:2.5rem; color:var(--muted); font-size:.82rem; border-top:1px solid var(--line); padding-top:1rem; }
</style></head><body><main>
<h1>$(_rep_html_esc "$title")</h1>

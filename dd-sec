#!/usr/bin/env bash
# =============================================================================
# dd-sec - Datadog Security CLI. Pure bash.
#
# A terminal replacement for the parts of the Datadog Security dashboard that
# a security engineer touches daily: findings, severity recasting, muting,
# automation rules, Work Management items, and raw SAST violations.
#
#   dd-sec start        interactive menu - the only command worth memorising
#   dd-sec <cmd> ...    direct invocation, for scripts and CI
#
# AUTHENTICATION IS LAZY. Nothing asks for a key until an action actually needs
# one, and when it does the login runs inline and the action continues. There
# is no separate "log in first" step to remember.
#
# Dependencies: bash 3.2+, curl, jq. No compile step, no runtime, one file.
#
# WHY API KEY + APP KEY AND NOT A BROWSER SESSION
# Datadog has no OAuth device authorization flow. Its OAuth2 is for
# Marketplace integrations: confidential clients with a client_secret, and
# Datadog does not recommend initiating authorization outside the integration
# tile. Reading the browser session instead would mean decrypting the cookie
# jar (Keychain-wrapped AES on macOS, DPAPI on Windows), scraping x-csrf-token
# out of the page HTML, and tracking x-web-ui-version across Datadog deploys.
# That is fragile, and a script that decrypts browser cookies is
# indistinguishable from an infostealer. App keys are revocable, scopable, and
# attributable in the audit log. So: app keys.
#
# PERMISSIONS, BY FEATURE
#   findings, recast   security_monitoring_findings_read / _write
#                      (appsec_vm_read / _write also satisfy these)
#   mute               security_monitoring_findings_write or appsec_vm_write
#   rules              security_pipelines_read / _write
#   work items         cases_read / cases_write
#   sast violations    code_analysis_read
#                      This is the one governing the cicodescan track. Without
#                      it the query returns 403 "User does not have permission
#                      for track cicodescan", which reads like a bad endpoint
#                      rather than a missing permission.
# =============================================================================
set -uo pipefail

VERSION="1.1.0-beta.1"
PROG="${0##*/}"

CFG_DIR="${DD_SEC_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/dd-sec}"
CRED_FILE="$CFG_DIR/credentials"
SESSION_FILE="$CFG_DIR/session.json"
AUDIT_DIR="$CFG_DIR/audit"
SESSION_TTL_SEC=43200   # 12h, then credentials are re-validated

# Probed in this order when the site is not known. /api/v1/validate needs only
# the API key, so this costs one cheap request per site and runs once.
SITES="datadoghq.com us5.datadoghq.com us3.datadoghq.com datadoghq.eu ap1.datadoghq.com ap2.datadoghq.com uk1.datadoghq.com ddog-gov.com us2.ddog-gov.com"

# Severity adjustment in the UI caps bulk selection at 50 findings; the mute
# endpoint documents 100. Both batch at their own limit.
BATCH_SEVERITY=50
BATCH_MUTE=100

# The logs-analytics endpoint is UNDOCUMENTED, so its server-side ceiling for
# `limit` is unknown and not guaranteed stable. This number is operational, not
# verified. Truncation is detected rather than assumed away - see dd_cicodescan.
SAST_QUERY_LIMIT="${SAST_QUERY_LIMIT:-5000}"
SAST_LOOKBACK_DAYS="${SAST_LOOKBACK_DAYS:-30}"

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YLW=$'\033[33m'
  C_BLU=$'\033[34m'; C_CYN=$'\033[36m'; C_BLD=$'\033[1m'
  C_DIM=$'\033[2m';  C_OFF=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YLW=""; C_BLU=""; C_CYN=""; C_BLD=""; C_DIM=""; C_OFF=""
fi

info() { printf '%s\n' "$*" >&2; }
step() { printf '%s→%s %s\n' "$C_BLU" "$C_OFF" "$*" >&2; }
ok()   { printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*" >&2; }
warn() { printf '%s!%s %s\n' "$C_YLW" "$C_OFF" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF" >&2; }
hdr()  { printf '\n%s%s%s\n' "$C_BLD" "$*" "$C_OFF" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

# In menu mode a failure must return to the menu, not kill the process. Every
# action is therefore called through run_action, which downgrades `die` to a
# message plus a non-zero return by running the action in a subshell.
MENU_MODE=false
run_action() {
  if [ "$MENU_MODE" = true ]; then
    ( "$@" ) || warn "Action failed. Returning to menu."
    return 0
  fi
  "$@"
}

need_deps() {
  local missing=""
  command -v curl >/dev/null 2>&1 || missing="$missing curl"
  command -v jq   >/dev/null 2>&1 || missing="$missing jq"
  [ -z "$missing" ] || die "Dependency missing:$missing
  macOS   : brew install jq
  Debian  : sudo apt install jq
  Windows : scoop install jq  (or use WSL)"
}

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum | cut -c1-64; }
elif command -v shasum >/dev/null 2>&1; then
  sha256() { shasum -a 256 | cut -c1-64; }
else
  sha256() { cksum | tr -d ' \n'; }   # not cryptographic, only used for keys
fi

# -----------------------------------------------------------------------------
# Secret store: macOS Keychain > libsecret > file with mode 600
# -----------------------------------------------------------------------------
keystore_kind() {
  case "${DD_SEC_KEYSTORE:-auto}" in
    file|keychain|secret) printf '%s' "$DD_SEC_KEYSTORE"; return ;;
  esac
  if [ "$(uname -s)" = "Darwin" ] && command -v security >/dev/null 2>&1; then
    printf 'keychain'
  elif command -v secret-tool >/dev/null 2>&1; then
    printf 'secret'
  else
    printf 'file'
  fi
}

secret_put() {
  case "$(keystore_kind)" in
    keychain) security add-generic-password -U -a "$USER" -s "dd-sec:$1" -w "$2" >/dev/null 2>&1 || die "Failed to write to Keychain" ;;
    secret)   printf '%s' "$2" | secret-tool store --label="dd-sec $1" service dd-sec key "$1" >/dev/null 2>&1 || die "Failed to write to libsecret" ;;
    file)
      mkdir -p "$CFG_DIR"; chmod 700 "$CFG_DIR" 2>/dev/null
      touch "$CRED_FILE"; chmod 600 "$CRED_FILE"
      local tmp; tmp="$(mktemp)"
      grep -v "^$1=" "$CRED_FILE" 2>/dev/null > "$tmp"
      printf '%s=%s\n' "$1" "$2" >> "$tmp"
      mv "$tmp" "$CRED_FILE"; chmod 600 "$CRED_FILE" ;;
  esac
}

secret_get() {
  case "$(keystore_kind)" in
    keychain) security find-generic-password -a "$USER" -s "dd-sec:$1" -w 2>/dev/null ;;
    secret)   secret-tool lookup service dd-sec key "$1" 2>/dev/null ;;
    file)     [ -f "$CRED_FILE" ] && sed -n "s/^$1=//p" "$CRED_FILE" | tail -1 ;;
  esac
}

secret_del() {
  case "$(keystore_kind)" in
    keychain) security delete-generic-password -a "$USER" -s "dd-sec:$1" >/dev/null 2>&1 ;;
    secret)   secret-tool clear service dd-sec key "$1" >/dev/null 2>&1 ;;
    file)
      if [ -f "$CRED_FILE" ]; then
        local tmp; tmp="$(mktemp)"
        grep -v "^$1=" "$CRED_FILE" > "$tmp" 2>/dev/null
        mv "$tmp" "$CRED_FILE"; chmod 600 "$CRED_FILE"
      fi ;;
  esac
  return 0
}

# -----------------------------------------------------------------------------
# Site and URL shapes.
# The API host is always api.<site>. The APP host is not: US1 and EU prefix
# with "app.", while regional sites (us3, us5, ap1) are their own hostname.
# -----------------------------------------------------------------------------
api_base() { printf 'https://api.%s' "$1"; }
app_base() {
  case "$1" in
    datadoghq.com|datadoghq.eu|ddog-gov.com) printf 'https://app.%s' "$1" ;;
    *)                                       printf 'https://%s' "$1" ;;
  esac
}

open_url() {
  local url="$1"
  if   command -v open           >/dev/null 2>&1; then open "$url" >/dev/null 2>&1 &
  elif command -v xdg-open       >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
  elif command -v powershell.exe >/dev/null 2>&1; then powershell.exe -NoProfile -Command "Start-Process '$url'" >/dev/null 2>&1 &
  elif command -v cmd.exe        >/dev/null 2>&1; then cmd.exe /c start "" "$url" >/dev/null 2>&1 &
  else warn "Open manually: $url"; return 1; fi
  return 0
}

urlencode() { printf '%s' "$1" | jq -sRr @uri; }

# -----------------------------------------------------------------------------
# HTTP
#   dd_req METHOD PATH [BODY] [SITE] [API_KEY] [APP_KEY]
# Sets HTTP_CODE, HTTP_BODY, RL_REMAINING, RL_RESET. Returns 0 on 2xx only.
# -----------------------------------------------------------------------------
HTTP_CODE=""; HTTP_BODY=""; RL_REMAINING=""; RL_RESET=""

dd_req() {
  local method="$1" path="$2" body="${3:-}"
  local site="${4:-${DD_SITE_R:-}}" ak="${5:-${DD_API_KEY_R:-}}" pk="${6:-${DD_APP_KEY_R:-}}"
  local hdr; hdr="$(mktemp)"
  local url; url="$(api_base "$site")$path"

  set -- -sS -X "$method" -D "$hdr" -o /dev/stdout -w '\n%{http_code}' \
         --connect-timeout 10 --max-time 120 \
         -H "DD-API-KEY: $ak" -H "DD-APPLICATION-KEY: $pk" \
         -H "Accept: application/json" -H "User-Agent: dd-sec/$VERSION"
  [ -z "$body" ] || set -- "$@" -H "Content-Type: application/json" --data-binary "$body"

  local raw; raw="$(curl "$@" "$url" 2>/dev/null)"
  HTTP_CODE="${raw##*$'\n'}"
  HTTP_BODY="${raw%$'\n'*}"
  RL_REMAINING="$(sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]emaining: *//p' "$hdr" | tr -d '\r' | tail -1)"
  RL_RESET="$(sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]eset: *//p' "$hdr" | tr -d '\r' | tail -1)"
  rm -f "$hdr"
  [ -n "$HTTP_CODE" ] || HTTP_CODE="000"
  case "$HTTP_CODE" in 2*) return 0 ;; *) return 1 ;; esac
}

# Retries 429 using x-ratelimit-reset, and 5xx / connection failures with a
# linear backoff. A 4xx other than 429 is returned immediately: retrying a
# validation error just wastes time.
dd_req_retry() {
  local attempt=1 max=5 wait
  while :; do
    dd_req "$@" && return 0
    case "$HTTP_CODE" in
      429)
        wait="${RL_RESET:-}"
        case "$wait" in ''|*[!0-9]*) wait=$(( attempt * 5 )) ;; esac
        [ "$wait" -gt 120 ] && wait=120
        warn "Rate limited, waiting ${wait}s (${attempt}/${max})"; sleep "$wait" ;;
      5*|000)
        wait=$(( attempt * 3 ))
        warn "HTTP $HTTP_CODE, retry ${wait}s (${attempt}/${max})"; sleep "$wait" ;;
      *) return 1 ;;
    esac
    attempt=$(( attempt + 1 ))
    [ "$attempt" -le "$max" ] || return 1
  done
}

api_error() {
  printf '%s' "$HTTP_BODY" | jq -r '
    (.errors // empty) as $e
    | if ($e|type) == "array" then
        ($e | map(if type=="object" then (.detail // .title // tostring) else tostring end) | join("; "))
      else tostring end' 2>/dev/null \
  || printf '%s' "$HTTP_BODY" | head -c 300
}

explain_http() {
  case "$HTTP_CODE" in
    401) warn "401 - API key or App key invalid for site ${DD_SITE_R:-?}." ;;
    403) warn "403 - App key lacks permission for this endpoint. See this file's header for the per-feature permission mapping." ;;
    404) warn "404 - resource not found, or endpoint not available in this org." ;;
    *)   warn "HTTP $HTTP_CODE: $(api_error)" ;;
  esac
}

# -----------------------------------------------------------------------------
# cicodescan query (undocumented logs-analytics endpoint)
#   dd_cicodescan QUERY OUTFILE [strict]
#
# strict=true (default) means the result MUST be complete and the call fails
# closed when truncation is suspected. Two independent checks, because either
# one alone has a blind spot:
#   1. hitCount larger than the number of returned events proves data was left
#      behind.
#   2. a result exactly equal to the limit is indistinguishable from a
#      truncated one, and check 1 is blind when the server truncates hitCount
#      too. No server cap can be assumed on an undocumented endpoint.
# strict=false is for existence probes, where completeness does not matter.
# -----------------------------------------------------------------------------
dd_cicodescan() {
  local query="$1" out="$2" strict="${3:-true}" body code hit ret now t_from t_to
  now="$(date -u +%s)"
  t_from=$(( (now - SAST_LOOKBACK_DAYS * 86400) * 1000 ))
  t_to=$(( (now + 3600) * 1000 ))

  body="$(jq -nc --arg q "$query" --argjson from "$t_from" --argjson to "$t_to" \
    --argjson lim "$SAST_QUERY_LIMIT" '{
      list: { columns: [], sorts: [], limit: $lim,
              time: {from: $from, to: $to},
              search: {query: $q},
              includeEvents: true, includeEventContents: true,
              computeCount: true, indexes: ["*"], executionInfo: {} } }')"

  code="$(curl -sS -X POST "$(api_base "$DD_SITE_R")/api/v1/logs-analytics/list?type=cicodescan" \
    -H 'Accept: application/json' -H 'Content-Type: application/json' \
    -H "DD-API-KEY: ${DD_API_KEY_R}" -H "DD-APPLICATION-KEY: ${DD_APP_KEY_R}" \
    --data "$body" --max-time 60 -o "$out" -w '%{http_code}')" || {
      warn "curl could not reach the logs-analytics endpoint"; return 1; }

  if [ "$code" -lt 200 ] || [ "$code" -ge 300 ]; then
    warn "HTTP ${code} from logs-analytics"
    head -c 300 "$out" >&2; printf '\n' >&2
    if [ "$code" = "403" ]; then
      dim "  a 403 here usually means the App key lacks 'code_analysis_read'"
      dim "  (Code Analysis Read), the permission that governs the cicodescan track."
      dim "  Check DD_SITE too: a key from another site is rejected with the same status."
    fi
    return 1
  fi

  # Shape validation. The endpoint is undocumented, so a structural change must
  # be loud rather than read as "zero findings".
  if ! jq -e '.result | (.events | type) == "array"' "$out" >/dev/null 2>&1; then
    warn "Unrecognized response shape: .result.events is not an array."
    dim "  The endpoint may have changed. Do not trust this result."
    return 1
  fi

  hit="$(jq -r '.hitCount // 0' "$out")"
  ret="$(jq -r '.result.events | length' "$out")"
  [ "$strict" = "true" ] || return 0

  if [ "$hit" -gt "$ret" ]; then
    warn "hitCount=${hit} but only ${ret} events returned - result truncated."
    dim "  Raise SAST_QUERY_LIMIT (currently ${SAST_QUERY_LIMIT}). Fail closed."
    return 1
  fi
  if [ "$ret" -ge "$SAST_QUERY_LIMIT" ]; then
    warn "Event count (${ret}) equals SAST_QUERY_LIMIT - possibly truncated."
    dim "  Raise the limit and retry. If the number does not grow, that is the"
    dim "  server ceiling, and the query must be narrowed. Fail closed."
    return 1
  fi
}

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
DD_SITE_R=""; DD_API_KEY_R=""; DD_APP_KEY_R=""
SEV_MODE=""; ORG_NAME=""; PROJECT_ID=""

session_field() { [ -f "$SESSION_FILE" ] && jq -r --arg k "$1" '.[$k] // ""' "$SESSION_FILE" 2>/dev/null; }

session_set() { # key value
  mkdir -p "$CFG_DIR"; chmod 700 "$CFG_DIR" 2>/dev/null
  local tmp; tmp="$(mktemp)"
  if [ -f "$SESSION_FILE" ]; then
    jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$SESSION_FILE" > "$tmp" 2>/dev/null \
      || jq -n --arg k "$1" --arg v "$2" '{($k): $v}' > "$tmp"
  else
    jq -n --arg k "$1" --arg v "$2" '{($k): $v}' > "$tmp"
  fi
  mv "$tmp" "$SESSION_FILE"; chmod 600 "$SESSION_FILE"
}

session_age() {
  local ts; ts="$(session_field validated_at)"
  case "$ts" in ''|*[!0-9]*) echo 999999; return ;; esac
  echo $(( $(date +%s) - ts ))
}

load_creds() {
  DD_API_KEY_R="${DD_API_KEY:-$(secret_get DD_API_KEY)}"
  DD_APP_KEY_R="${DD_APP_KEY:-$(secret_get DD_APP_KEY)}"
  DD_SITE_R="${DD_SITE:-$(session_field site)}"
  [ -n "$DD_SITE_R" ] || DD_SITE_R="$(secret_get DD_SITE)"
  SEV_MODE="$(session_field severity_mode)"
  ORG_NAME="$(session_field org)"
  PROJECT_ID="${DD_CASES_PROJECT_ID:-$(session_field project_id)}"
}

# LAZY AUTH. This is the whole point of `dd-sec start`: an action calls
# need_auth, and if there is no usable session the login happens right here and
# the action carries on. Nothing has to be run beforehand.
need_auth() {
  load_creds
  if [ -z "$DD_API_KEY_R" ] || [ -z "$DD_APP_KEY_R" ] || [ -z "$DD_SITE_R" ]; then
    if [ -t 0 ]; then
      hdr "Authentication required for this action"
      cmd_auth_login || die "Login cancelled"
      load_creds
    else
      die "Not logged in and no TTY. Set DD_API_KEY / DD_APP_KEY / DD_SITE, or run: $PROG auth login"
    fi
  fi
  if [ "$(session_age)" -gt "$SESSION_TTL_SEC" ]; then
    step "Session older than 12h, re-validating..."
    if validate_creds "$DD_SITE_R"; then
      session_set validated_at "$(date +%s)"
    else
      warn "Credentials no longer valid."
      if [ -t 0 ]; then
        cmd_auth_login || die "Login cancelled"; load_creds
      else
        die "Run: $PROG auth login"
      fi
    fi
  fi
}

# -----------------------------------------------------------------------------
# Validation and capability probing
# -----------------------------------------------------------------------------
detect_site() {
  local s
  for s in $SITES; do
    if dd_req GET /api/v1/validate "" "$s" "$DD_API_KEY_R" "$DD_APP_KEY_R"; then
      if [ "$(printf '%s' "$HTTP_BODY" | jq -r '.valid // false' 2>/dev/null)" = "true" ]; then
        printf '%s' "$s"; return 0
      fi
    fi
  done
  return 1
}

# Exercises the app key on the endpoint the tool actually needs, not on a
# generic one: a key can validate and still lack findings access.
validate_creds() {
  local s="$1"
  if ! dd_req GET '/api/v2/security/findings?page%5Blimit%5D=1' "" "$s"; then
    explain_http; return 1
  fi
  ORG_NAME="$(printf '%s' "$HTTP_BODY" | jq -r '.meta.org_name // ""' 2>/dev/null)"
  [ -n "$ORG_NAME" ] || ORG_NAME="(unknown)"
  return 0
}

# Is PATCH /api/v2/security/findings/severity reachable with key auth?
# The probe sends an EMPTY findings list. A 4xx validation error means auth
# passed and the handler was reached; 401/403 means it was not. Nothing is
# mutated on either path, which is why this is safe to run at login.
probe_severity_mode() {
  local probe='{"data":{"type":"severity_override","attributes":{"severity":{"action":"set","value":"high"}},"relationships":{"findings":{"data":[]}}}}'
  dd_req PATCH /api/v2/security/findings/severity "$probe"
  case "$HTTP_CODE" in
    2*|400|404|409|422) printf 'direct' ;;
    401|403)            printf 'rule'   ;;
    *)                  printf 'unknown' ;;
  esac
}

self_principal() {
  dd_req GET /api/v2/current_user >/dev/null 2>&1 || return 1
  printf '%s' "$HTTP_BODY" | jq -r '.data.id // empty' 2>/dev/null
}

# -----------------------------------------------------------------------------
# auth
# -----------------------------------------------------------------------------
read_secret() {
  local p="$1" v=""
  printf '%s' "$p" >&2
  [ -t 0 ] && stty -echo 2>/dev/null
  IFS= read -r v
  [ -t 0 ] && { stty echo 2>/dev/null; printf '\n' >&2; }
  printf '%s' "$v"
}

cmd_auth_login() {
  local mode="" site_in="" ak="" pk=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) mode="$2"; shift 2 ;;
      --site) site_in="$2"; shift 2 ;;
      --api-key) ak="$2"; shift 2 ;;
      --app-key) pk="$2"; shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done

  if [ -z "$mode" ]; then
    if   [ -n "$ak" ] && [ -n "$pk" ]; then mode=manual
    elif [ -n "${DD_API_KEY:-}" ] && [ -n "${DD_APP_KEY:-}" ]; then mode=env
    elif [ -t 0 ]; then
      info ""
      info "  1) Browser  - open Datadog, create a key, paste it back"
      info "  2) Manual   - paste an existing API Key + App Key"
      info "  3) Env      - use DD_API_KEY / DD_APP_KEY from the environment"
      info ""
      printf '  Select [1-3]: ' >&2
      local pick; IFS= read -r pick || return 1
      case "$pick" in
        1) mode=browser ;; 2) mode=manual ;; 3) mode=env ;;
        *) warn "Invalid choice"; return 1 ;;
      esac
    else
      die "Non-interactive: use --api-key/--app-key or set DD_API_KEY/DD_APP_KEY"
    fi
  fi

  case "$mode" in
    env)
      ak="${DD_API_KEY:-}"; pk="${DD_APP_KEY:-}"
      [ -n "$ak" ] && [ -n "$pk" ] || die "DD_API_KEY / DD_APP_KEY not set" ;;
    browser)
      local ui="${site_in:-${DD_SITE:-datadoghq.com}}"
      local kurl aurl
      aurl="$(app_base "$ui")/organization-settings/api-keys"
      kurl="$(app_base "$ui")/organization-settings/application-keys"
      info ""
      step "Opening the API Keys & Application Keys pages"
      dim "  Log in / SSO first if needed, then 'New Key' and copy."
      open_url "$aurl"; sleep 1; open_url "$kurl"
      info ""
      dim "  API Key : $aurl"
      dim "  App Key : $kurl"
      info ""
      [ -n "$ak" ] || ak="$(read_secret '  Paste API Key : ')"
      [ -n "$pk" ] || pk="$(read_secret '  Paste App Key : ')" ;;
    manual)
      [ -n "$ak" ] || ak="$(read_secret '  API Key : ')"
      [ -n "$pk" ] || pk="$(read_secret '  App Key : ')" ;;
    *) die "Unknown mode: $mode" ;;
  esac

  ak="$(printf '%s' "$ak" | tr -d '[:space:]')"
  pk="$(printf '%s' "$pk" | tr -d '[:space:]')"
  [ -n "$ak" ] && [ -n "$pk" ] || { warn "Empty key"; return 1; }
  DD_API_KEY_R="$ak"; DD_APP_KEY_R="$pk"

  local site="${site_in:-${DD_SITE:-}}"
  if [ -n "$site" ]; then
    step "Site set manually: $site"
  else
    step "Detecting site..."
    site="$(detect_site)" || die "Site not detected. Check the API key, or set --site.
  Valid sites: $SITES"
    ok "Site: $site"
  fi
  DD_SITE_R="$site"

  step "Validating credentials (findings:read)..."
  validate_creds "$site" || return 1
  ok "Org: $ORG_NAME"

  step "Probing severity capability..."
  local m; m="$(probe_severity_mode)"
  case "$m" in
    direct) ok "Per-finding recast available (mode: direct)" ;;
    rule)   warn "Per-finding recast denied (HTTP $HTTP_CODE) - falling back to severity modifier rules (mode: rule)" ;;
    *)      warn "Ambiguous probe (HTTP $HTTP_CODE) - mode: unknown" ;;
  esac

  if [ "$mode" != "env" ]; then
    secret_put DD_API_KEY "$ak"; secret_put DD_APP_KEY "$pk"; secret_put DD_SITE "$site"
    dim "  Credentials stored via keystore: $(keystore_kind)"
  else
    dim "  Env mode: credentials NOT written to disk"
  fi

  session_set site "$site"; session_set org "$ORG_NAME"
  session_set severity_mode "$m"; session_set validated_at "$(date +%s)"
  SEV_MODE="$m"
  ok "Session active (TTL 12h)"
}

cmd_auth_status() {
  load_creds
  if [ -z "$DD_API_KEY_R" ] || [ -z "$DD_APP_KEY_R" ]; then
    info "Status   : not logged in"
    info "Keystore : $(keystore_kind)"
    return 0
  fi
  local age; age="$(session_age)"
  info "Status        : logged in"
  info "Site          : ${DD_SITE_R:-?}"
  info "Org           : ${ORG_NAME:-?}"
  info "Severity mode : ${SEV_MODE:-?}"
  info "WM project    : ${PROJECT_ID:-<not selected>}"
  info "Keystore      : $(keystore_kind)"
  info "API key       : ...${DD_API_KEY_R: -4}"
  info "App key       : ...${DD_APP_KEY_R: -4}"
  if [ "$age" -gt "$SESSION_TTL_SEC" ]; then
    info "Session age   : $((age/3600))h (expired, will re-validate)"
  else
    info "Session age   : $((age/60))m"
  fi
}

cmd_auth_logout() {
  secret_del DD_API_KEY; secret_del DD_APP_KEY; secret_del DD_SITE
  rm -f "$SESSION_FILE"
  ok "Local credentials & session deleted"
  dim "  This does NOT revoke the key in Datadog. Revoke at:"
  dim "  $(app_base "${DD_SITE_R:-datadoghq.com}")/organization-settings/application-keys"
}

# Probes every feature's permission in one pass, so a 403 later is never a
# surprise. Each line is a real request against the endpoint that feature uses.
cmd_auth_probe() {
  need_auth
  hdr "Permission probe - org ${ORG_NAME:-?} @ ${DD_SITE_R}"

  local me; me="$(self_principal || true)"
  [ -z "$me" ] || info "  identity            : user:${me}"

  printf '  findings:read       : ' >&2
  if dd_req GET '/api/v2/security/findings?page%5Blimit%5D=1'; then printf '%sOK%s\n' "$C_GRN" "$C_OFF" >&2
  else printf '%sHTTP %s%s\n' "$C_RED" "$HTTP_CODE" "$C_OFF" >&2; fi

  printf '  severity:write      : ' >&2
  local m; m="$(probe_severity_mode)"
  case "$m" in
    direct) printf '%sdirect%s (per-finding recast active)\n' "$C_GRN" "$C_OFF" >&2 ;;
    rule)   printf '%srule%s (HTTP %s - using severity modifier rules)\n' "$C_YLW" "$C_OFF" "$HTTP_CODE" >&2 ;;
    *)      printf '%sunknown%s (HTTP %s)\n' "$C_YLW" "$C_OFF" "$HTTP_CODE" >&2 ;;
  esac
  session_set severity_mode "$m"

  printf '  pipelines:read      : ' >&2
  if dd_req GET /api/v2/security/findings/automation/severity_modifier_rules; then
    printf '%sOK%s (%s rule)\n' "$C_GRN" "$C_OFF" "$(printf '%s' "$HTTP_BODY" | jq -r '.data|length')" >&2
  else printf '%sHTTP %s%s\n' "$C_RED" "$HTTP_CODE" "$C_OFF" >&2; fi

  printf '  cases:read          : ' >&2
  if dd_req GET '/api/v2/cases/projects'; then
    printf '%sOK%s (%s project)\n' "$C_GRN" "$C_OFF" "$(printf '%s' "$HTTP_BODY" | jq -r '.data|length')" >&2
  else printf '%sHTTP %s%s\n' "$C_RED" "$HTTP_CODE" "$C_OFF" >&2; fi

  printf '  code_analysis_read  : ' >&2
  local t; t="$(mktemp)"
  if dd_cicodescan '@static_analysis.result.item_type:static_analysis_violation' "$t" false >/dev/null 2>&1; then
    printf '%sOK%s\n' "$C_GRN" "$C_OFF" >&2
  else printf '%sfailed%s (see message above)\n' "$C_RED" "$C_OFF" >&2; fi
  rm -f "$t"
  info ""
}

# -----------------------------------------------------------------------------
# findings
#
# FIELD DISCOVERY, NOT FIELD GUESSING
# The attribute shape of /api/v2/security/findings differs by finding type:
# a posture-management finding carries `evaluation` where a code-security one
# carries a severity object, and neither layout is guaranteed across org
# configurations. Hardcoding one path is how every row ended up as
# "UNKNOWN ? ?".
#
# So extraction runs in two stages. First a list of known candidate paths, in
# preference order. If every one of them misses, a DEEP SEARCH walks the whole
# attributes object for any scalar under a key named severity / status / name,
# which survives a layout this code has never seen. When even that misses, the
# caller says so out loud and points at `findings keys`, rather than printing a
# screen of question marks as if that were the data.
# -----------------------------------------------------------------------------

# jq program shared by the table view. Emits TSV:
#   id, severity, status, title, resource
FINDINGS_JQ='
  # First non-empty string from a list of candidates.
  def pick(c): [ c ] | map(select(type == "string" and . != "" and . != "null")) | (.[0] // "");
  # Deep search: any scalar whose key matches, anywhere under the object.
  def deep($re): [ .. | objects | to_entries[]
                   | select(.key | test($re))
                   | .value | select(type == "string" and . != "") ] | (.[0] // "");

  .data[]? | . as $f | (.attributes // {}) as $a |
  [ ($f.id? // ""),

    ( pick( $a.severity?, $a.severity_details?.adjusted?.value?,
            $a.severity_details?.original?.value?, $a.severity_details?.value?,
            $a.vulnerability?.severity?, $a.finding?.severity?, $a.k9_severity? )
      | if . == "" then ($a | deep("^(k9_)?severity$")) else . end ),

    ( pick( $a.status?, $a.state?, $a.evaluation?, $a.finding_status? )
      | if . == "" then ($a | deep("^(status|evaluation)$")) else . end ),

    ( pick( $a.rule?.name?, $a.rule_name?, $a.vulnerability?.title?, $a.title?,
            $a.message?, $a.rule?.id?, $a.finding_type?, $a.vulnerability_type? )
      | if . == "" then ($a | deep("^(name|title|rule_id)$")) else . end ),

    ( pick( $a.resource?, $a.location?.file_path?, $a.location?.file?,
            $a.git?.repository?.name?, $a.repository?.name?, $a.service?,
            $a.resource_type?, $a.high_level_resource_type? ) )
  ] | @tsv'

findings_fetch() { # query max
  local query="$1" max="${2:-500}" cursor="" got=0 page=1 qs limit n
  while :; do
    limit=$(( max - got )); [ "$limit" -gt 150 ] && limit=150
    [ "$limit" -le 0 ] && break
    qs="page%5Blimit%5D=$limit"
    [ -n "$query" ]  && qs="$qs&filter%5Bquery%5D=$(urlencode "$query")"
    [ -n "$cursor" ] && qs="$qs&page%5Bcursor%5D=$(urlencode "$cursor")"

    dd_req_retry GET "/api/v2/security/findings?$qs" || { explain_http; return 1; }

    printf '%s' "$HTTP_BODY" | jq -r "$FINDINGS_JQ"

    n="$(printf '%s' "$HTTP_BODY" | jq -r '.data|length')"
    got=$(( got + n ))
    cursor="$(printf '%s' "$HTTP_BODY" | jq -r '.meta.page.cursor // ""')"
    [ -n "$cursor" ] && [ "$cursor" != "null" ] && [ "$n" -gt 0 ] || break
    page=$(( page + 1 ))
    dim "  ...page $page (total $got)"
  done
}

# Prints the real attribute layout of one finding, as dotted paths plus a
# truncated value. This is the 30-second way to pin the paths in FINDINGS_JQ
# against an actual org instead of arguing with the docs.
cmd_findings_keys() {
  need_auth
  local query=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --query) query="$2"; shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  local qs="page%5Blimit%5D=1"
  [ -n "$query" ] && qs="$qs&filter%5Bquery%5D=$(urlencode "$query")"
  dd_req_retry GET "/api/v2/security/findings?$qs" || { explain_http; return 1; }

  if [ "$(printf '%s' "$HTTP_BODY" | jq -r '(.data // []) | length')" -eq 0 ]; then
    warn "0 findings for this query; no shape to display."
    return 0
  fi

  hdr "Attribute layout (finding pertama)"
  printf '%s' "$HTTP_BODY" | jq -r '
    .data[0] as $f
    | ($f.attributes // {}) as $a
    | [ paths(scalars) as $p
        | { p: ($p | map(tostring) | join(".")),
            v: ($a | getpath($p) | tostring | .[0:58]) } ]
    | sort_by(.p)[]
    | "  \(.p)\u0009= \(.v)"' 2>/dev/null \
    | awk -F'\t' '{ printf "  %-46s %s\n", $1, $2 }' >&2
  info ""
  dim "  The columns to show in the table can be pinned in FINDINGS_JQ in this file."
  dim "  If severity/status live at another path, add it to pick(...) there."
}

cmd_findings_list() {
  need_auth
  local query="" max=200 as_json=0 export_to=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --query)  query="$2"; shift 2 ;;
      --limit)  max="$2"; shift 2 ;;
      --json)   as_json=1; shift ;;
      --export) export_to="$2"; shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done

  if [ "$as_json" -eq 1 ]; then
    local qs="page%5Blimit%5D=150"
    [ -n "$query" ] && qs="$qs&filter%5Bquery%5D=$(urlencode "$query")"
    dd_req_retry GET "/api/v2/security/findings?$qs" || { explain_http; return 1; }
    printf '%s\n' "$HTTP_BODY" | jq .
    return 0
  fi

  local t; t="$(mktemp)"
  findings_fetch "$query" "$max" > "$t" || { rm -f "$t"; return 1; }
  local n; n="$(grep -c '[^[:space:]]' < "$t" || true)"
  if [ "${n:-0}" -eq 0 ]; then
    warn "0 findings. Query: ${query:-<empty>}"
    rm -f "$t"; return 0
  fi

  # Sorted by descending severity so what matters is at the top of the screen,
  # THEN cached in that order - the displayed number and the cache index have to
  # be the same thing or "#3" means two different findings.
  local ts; ts="$(mktemp)"
  awk -F'\t' 'BEGIN{OFS="\t"}
    { s=tolower($2); r=7
      if      (s=="critical") r=1
      else if (s=="high")     r=2
      else if (s=="medium")   r=3
      else if (s=="low")      r=4
      else if (s=="info"||s=="none"||s=="info_none") r=5
      else if (s=="")         r=6
      print r, $0 }' "$t" \
    | sort -t"$(printf '\t')" -k1,1n -s | cut -f2- > "$ts"
  pick_write "$query" < "$ts"

  # An export is a round trip: the ids are filled in, the human fills in the
  # decision. TSV rather than CSV on purpose - finding names contain commas.
  if [ -n "$export_to" ]; then
    {
      printf 'finding_id\ttarget_severity\treason\tcurrent_severity\tname\tresource\n'
      awk -F'\t' 'BEGIN{OFS="\t"} { print $1, "", "", $2, $4, $5 }' "$ts"
    } > "$export_to"
    ok "$n findings exported to $export_to"
    info ""
    dim "  Fill target_severity and reason for the rows you want to change."
    dim "  Rows with an EMPTY target_severity are skipped, so deleting rows is"
    dim "  not needed. Then:"
    dim "    $PROG recast bulk --file $export_to          # dry-run"
    dim "    $PROG recast bulk --file $export_to --apply"
    rm -f "$t" "$ts"; return 0
  fi

  hdr "$n finding"
  # Empty cells render as "-" rather than "?": a dash reads as "not in the
  # response", a question mark reads as "the tool is confused".
  pick_rows \
    | awk -F'\t' '{
        sev = ($3 == "" ? "-" : toupper($3))
        st  = ($4 == "" ? "-" : $4)
        ti  = ($5 == "" ? "-" : $5)
        rs  = ($6 == "" ? ""  : $6)
        printf "  #%-4s %-9s %-10s %-40.40s %s\n", $1, sev, st, ti, rs }' >&2

  # If NOT ONE row resolved a severity, the extraction paths are wrong for this
  # org rather than the data being empty. Say that, instead of leaving a screen
  # of dashes to be interpreted as a clean result.
  local nosev
  nosev="$(awk -F'\t' '$2 == "" { c++ } END { print c+0 }' "$t")"
  info ""
  if [ "$nosev" -eq "$n" ]; then
    warn "Severity unreadable on ALL $n rows - the field path differs in this org."
    dim "  Run this to see the real layout, then pin the path:"
    dim "    $PROG findings keys ${query:+--query '$query'}"
  elif [ "$nosev" -gt 0 ]; then
    dim "  $nosev rows without severity (finding types that do not carry that field)."
  fi
  dim "  Recast by NUMBER, not ID - the ID never needs to be copied:"
  dim "    $PROG recast pick --select 3 --to high --reason '...'"
  dim "    $PROG recast pick --select 1,4,9  |  --select 2-10  |  --select all,!7"
  dim "  Detail of one row (including the full ID)  : $PROG findings show 3"
  dim "  Bulk review via file                       : add --export recast.tsv"
  rm -f "$t" "$ts"
}

# -----------------------------------------------------------------------------
# SELECTION CACHE
#
# A finding id is a 44-character opaque base64 string. It is the only thing the
# API accepts, but that is no reason to make a person handle it: retyping one
# from a terminal gives no confirmation of what is being changed, and a
# single-character typo is almost always a 404 but not guaranteed to be - it
# could resolve to a different real finding.
#
# So every `findings list` writes what it showed to a cache, numbered. The
# person then works with "#3" and the id never leaves the machine.
#
# The cache stores the QUERY, not just the rows, because ids are not guaranteed
# stable: a new scan produces new finding records, so a cache from 20 minutes
# ago can point at something that no longer exists. Before anything is applied
# the query is re-run and the selection is intersected with what is live now.
# Whatever no longer matches is dropped and reported, never silently recast.
# -----------------------------------------------------------------------------
PICK_FILE="$CFG_DIR/last-list.tsv"

pick_write() { # query < rows on stdin
  mkdir -p "$CFG_DIR"; chmod 700 "$CFG_DIR" 2>/dev/null
  {
    printf '#query\t%s\n' "$1"
    printf '#fetched_at\t%s\n' "$(date +%s)"
    awk -F'\t' 'BEGIN{OFS="\t"} { print NR, $0 }'
  } > "$PICK_FILE"
  chmod 600 "$PICK_FILE"
}

pick_query()   { [ -f "$PICK_FILE" ] && sed -n 's/^#query\t//p' "$PICK_FILE" | head -1; }
pick_fetched() { [ -f "$PICK_FILE" ] && sed -n 's/^#fetched_at\t//p' "$PICK_FILE" | head -1; }
pick_rows()    { [ -f "$PICK_FILE" ] && grep -v '^#' "$PICK_FILE"; }
pick_count()   { pick_rows | grep -c '[^[:space:]]' || true; }

# Selection syntax: 3 | 1,4,9 | 2-10 | all | combinations, with !N or !N-M to
# exclude. Exclusions are applied last, so "all,!7" means everything but 7.
expand_selection() { # spec max -> indices on stdout, one per line
  printf '%s' "$1" | tr ',' '\n' | awk -v max="$2" '
    { gsub(/^[ \t]+|[ \t]+$/, "") }
    /^$/ { next }
    tolower($0) == "all" { for (i = 1; i <= max; i++) inc[i] = 1; next }
    /^![0-9]+-[0-9]+$/ { s = substr($0,2); split(s, p, "-")
                         if (p[1] + 0 > p[2] + 0) { bad = $0; exit }
                         for (i = p[1]; i <= p[2]; i++) exc[i] = 1; next }
    /^![0-9]+$/        { exc[substr($0,2) + 0] = 1; next }
    /^[0-9]+-[0-9]+$/  { split($0, p, "-")
                         # A reversed range selects nothing, and silently
                         # selecting nothing is worse than an error: it reads
                         # as "done" when nothing happened.
                         if (p[1] + 0 < 1 || p[2] + 0 > max || p[1] + 0 > p[2] + 0) { bad = $0; exit }
                         for (i = p[1]; i <= p[2]; i++) inc[i] = 1; next }
    /^[0-9]+$/         { n = $0 + 0
                         if (n < 1 || n > max) { bad = $0; exit }
                         inc[n] = 1; next }
    { bad = $0; exit }
    END { if (bad != "") { printf "BAD\t%s\n", bad; exit 2 }
          for (i = 1; i <= max; i++) if (inc[i] && !exc[i]) print i }'
}

cmd_findings_show() {
  local idx="${1:-}"
  [ -n "$idx" ] || die "Usage: $PROG findings show N   (N is the number from findings list)"
  [ -f "$PICK_FILE" ] || die "No list yet. Run first: $PROG findings list"
  local row
  row="$(pick_rows | awk -F'\t' -v i="$idx" '$1 == i')"
  [ -n "$row" ] || die "Number #$idx is not in the last list ($(pick_count) rows)."

  local n id sev st ti rs
  IFS=$'\x1f' read -r n id sev st ti rs <<< "${row//$'\t'/$'\x1f'}"
  hdr "Finding #$n"
  info "  Name      : ${ti:--}"
  info "  Severity  : ${sev:--}"
  info "  Status    : ${st:--}"
  info "  Resource  : ${rs:--}"
  info ""
  info "  ID (full, for copy):"
  info "    $id"
  info ""
  dim "  But you do not need to copy it. Recast by its number:"
  dim "    $PROG recast pick --select $n --to high --reason '...'"
}

# Re-runs the cached query and keeps only the selected ids that are still live.
# Sets PICK_IDS (file path) and PICK_STALE (count).
PICK_IDS=""; PICK_STALE=0
pick_resolve() { # selection_spec
  local spec="$1" max q live sel
  max="$(pick_count)"
  [ "${max:-0}" -gt 0 ] || die "Last list is empty. Run: $PROG findings list"

  sel="$(mktemp)"
  if ! expand_selection "$spec" "$max" > "$sel" 2>/dev/null; then
    local bad; bad="$(expand_selection "$spec" "$max" 2>&1 | sed -n 's/^BAD\t//p' | head -1)"
    rm -f "$sel"
    die "Invalid selection: '${bad:-$spec}'
  Accepted forms: 3 | 1,4,9 | 2-10 | all | all,!7
  Available range: 1-$max"
  fi
  local nsel; nsel="$(grep -c '[^[:space:]]' < "$sel" || true)"
  [ "${nsel:-0}" -gt 0 ] || { rm -f "$sel"; die "Selection '$spec' selected nothing."; }

  # Staleness: ids can change between scans, so the cache is never trusted on
  # its own. The cached query is re-run and the selection intersected with it.
  local age; age=$(( $(date +%s) - $(pick_fetched) ))
  q="$(pick_query)"
  step "Verifikasi ulang $nsel pilihan terhadap data live (cache umur $((age/60))m)..."
  live="$(mktemp)"
  findings_fetch "$q" 500 | cut -f1 | sort -u > "$live" || { rm -f "$sel" "$live"; return 1; }

  PICK_IDS="$(mktemp)"
  : > "$PICK_IDS"
  local i row id
  while IFS= read -r i; do
    [ -n "$i" ] || continue
    row="$(pick_rows | awk -F'\t' -v k="$i" '$1 == k')"
    id="$(printf '%s' "$row" | cut -f2)"
    if grep -qxF "$id" "$live"; then
      printf '%s\t%s\n' "$i" "$id" >> "$PICK_IDS"
    else
      PICK_STALE=$(( PICK_STALE + 1 ))
      warn "  #$i no longer in the query result - skipped (finding changed/removed)"
    fi
  done < "$sel"
  rm -f "$sel" "$live"

  local kept; kept="$(grep -c '[^[:space:]]' < "$PICK_IDS" || true)"
  [ "${kept:-0}" -gt 0 ] || die "All selections are stale. Re-run: $PROG findings list"
  ok "$kept finding valid${PICK_STALE:+, $PICK_STALE dilewati}"
}

# Prints what is about to change, by NAME, before anything is sent.
pick_preview() { # target
  local target="$1" i id row sev ti
  hdr "About to change → $(printf '%s' "$target" | tr '[:lower:]' '[:upper:]')"
  while IFS= read -r _l; do
    IFS=$'\x1f' read -r i id <<< "${_l//$'\t'/$'\x1f'}"
    [ -n "${i:-}" ] || continue
    row="$(pick_rows | awk -F'\t' -v k="$i" '$1 == k')"
    sev="$(printf '%s' "$row" | cut -f3)"
    ti="$(printf '%s' "$row" | cut -f5)"
    printf '  #%-4s %-9s → %-9s %s\n' "$i" "$(printf '%s' "${sev:--}" | tr '[:lower:]' '[:upper:]')" \
      "$(printf '%s' "$target" | tr '[:lower:]' '[:upper:]')" "${ti:--}" >&2
  done < "$PICK_IDS"
}

cmd_recast_pick() {
  need_auth; guard_severity_mode
  local spec="" target="" reason="" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --select) spec="$2"; shift 2 ;;
      --to) target="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$spec" ]   || die "--select required (e.g. 3 | 1,4,9 | 2-10 | all | all,!7)"
  [ -n "$target" ] || die "--to required"
  valid_sev "$target" || die "Invalid severity: $target"
  [ -n "$reason" ] || die "--reason required"
  target="$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')"

  pick_resolve "$spec" || return 1
  pick_preview "$target"
  info ""
  cut -f2 "$PICK_IDS" | batch_stream severity_batch "$BATCH_SEVERITY" "$target" "$reason" "$apply"
  local rc=$?; rm -f "$PICK_IDS"; return $rc
}

cmd_mute_pick() {
  need_auth
  local spec="" reason="" unmute=0 apply=0 muted=true allowed
  while [ $# -gt 0 ]; do
    case "$1" in
      --select) spec="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --unmute) unmute=1; shift ;;
      --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$spec" ] || die "--select required"
  [ -n "$reason" ] || die "--reason required"
  reason="$(printf '%s' "$reason" | tr '[:lower:]' '[:upper:]')"
  if [ "$unmute" -eq 1 ]; then muted=false; allowed="$UNMUTE_REASONS"
  else muted=true; allowed="$MUTE_REASONS"; fi
  printf '%s' "$allowed" | tr ' ' '\n' | grep -qx "$reason" \
    || die "Reason '$reason' is not valid for this direction.
  Valid: $allowed"

  pick_resolve "$spec" || return 1
  pick_preview "muted=$muted"
  info ""
  cut -f2 "$PICK_IDS" | batch_stream mute_batch "$BATCH_MUTE" "$muted" "$reason" "$apply"
  local rc=$?; rm -f "$PICK_IDS"; return $rc
}

# -----------------------------------------------------------------------------
# recast (severity override)
# -----------------------------------------------------------------------------
# Severity floors differ per finding type. Info/None is rejected for
# static_code_vulnerability, secret, iac_misconfiguration and
# runtime_code_vulnerability, whose floor is low.
valid_sev() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    info|none|info_none|low|medium|high|critical) return 0 ;;
    *) return 1 ;;
  esac
}

audit_log() { # kind target_id action detail http_code
  mkdir -p "$AUDIT_DIR"; chmod 700 "$AUDIT_DIR" 2>/dev/null
  local f="$AUDIT_DIR/dd-sec-$(date +%Y%m%d).csv"
  if [ ! -f "$f" ]; then
    printf 'timestamp,site,org,kind,target_id,action,detail,http_code\n' > "$f"
    chmod 600 "$f"
  fi
  printf '%s,%s,"%s",%s,%s,%s,"%s",%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${DD_SITE_R:-?}" "${ORG_NAME:-?}" \
    "$1" "$2" "$3" "$(printf '%s' "$4" | sed 's/"/""/g')" "$5" >> "$f"
}

guard_severity_mode() {
  [ -n "$SEV_MODE" ] || SEV_MODE="$(session_field severity_mode)"
  if [ "$SEV_MODE" = "rule" ]; then
    die "The per-finding severity endpoint does not accept key auth in this org.
  Use    : $PROG rule create ...
  Recheck: $PROG auth probe"
  fi
}

# One PATCH per batch. ids arrive on stdin, one per line.
severity_batch() { # target reason
  local target="$1" reason="$2" ids body n
  ids="$(cat)"
  n="$(printf '%s\n' "$ids" | grep -c '[^[:space:]]' || true)"
  [ "${n:-0}" -gt 0 ] || return 0

  body="$(printf '%s\n' "$ids" | jq -R 'select(length>0)' | jq -sc \
    --arg sev "$target" --arg desc "$reason" '
    { data: { type: "severity_override",
              attributes: { severity: { action: "set", value: $sev } }
                + (if $desc == "" then {} else { description: $desc } end),
              relationships: { findings: { data: map({type:"findings", id:.}) } } } }')"

  local rc=0
  if dd_req_retry PATCH /api/v2/security/findings/severity "$body"; then
    ok "batch $n finding → $target (HTTP $HTTP_CODE)"
  else
    warn "batch FAILED (HTTP $HTTP_CODE): $(api_error)"; rc=1
  fi
  printf '%s\n' "$ids" | while IFS= read -r id; do
    [ -n "$id" ] && audit_log finding "$id" "severity=$target" "$reason" "$HTTP_CODE"
  done
  return $rc
}

mute_batch() { # is_muted reason
  local muted="$1" reason="$2" ids body n
  ids="$(cat)"
  n="$(printf '%s\n' "$ids" | grep -c '[^[:space:]]' || true)"
  [ "${n:-0}" -gt 0 ] || return 0

  body="$(printf '%s\n' "$ids" | jq -R 'select(length>0)' | jq -sc \
    --argjson m "$muted" --arg r "$reason" '
    { data: { type: "finding",
              attributes: { mute: { is_muted: $m, reason: $r } },
              relationships: { findings: { data: map({type:"finding", id:.}) } } } }')"

  local rc=0
  if dd_req_retry PATCH /api/v2/security/findings/mute "$body"; then
    ok "batch $n finding → muted=$muted (HTTP $HTTP_CODE)"
  else
    warn "batch FAILED (HTTP $HTTP_CODE): $(api_error)"; rc=1
  fi
  printf '%s\n' "$ids" | while IFS= read -r id; do
    [ -n "$id" ] && audit_log finding "$id" "mute=$muted" "$reason" "$HTTP_CODE"
  done
  return $rc
}

# Batches ids from stdin through a handler. Staged in a temp file so memory
# stays flat no matter how many findings are involved.
batch_stream() { # batch_fn size arg1 arg2 apply
  local fn="$1" size="$2" a1="$3" a2="$4" apply="$5"
  local count=0 total=0 batches=0 failed=0 id
  local buf; buf="$(mktemp)"

  _flush() {
    batches=$(( batches + 1 ))
    if [ "$apply" -eq 1 ]; then
      "$fn" "$a1" "$a2" < "$buf" || failed=$(( failed + 1 ))
    else
      info "  [dry-run] batch $batches: $count finding"
    fi
    : > "$buf"; count=0
  }

  while IFS= read -r id; do
    id="$(printf '%s' "$id" | tr -d '[:space:]')"
    [ -n "$id" ] || continue
    printf '%s\n' "$id" >> "$buf"
    count=$(( count + 1 )); total=$(( total + 1 ))
    [ "$count" -ge "$size" ] && _flush
  done
  [ "$count" -gt 0 ] && _flush
  rm -f "$buf"

  info ""
  if [ "$apply" -eq 1 ]; then
    ok "Done: $total findings, $batches batches, $failed failed"
    dim "  Audit: $AUDIT_DIR/dd-sec-$(date +%Y%m%d).csv"
  else
    warn "DRY-RUN: $total findings in $batches batches. Add --apply to execute."
  fi
  [ "$failed" -eq 0 ]
}

cmd_recast_one() {
  need_auth; guard_severity_mode
  local id="" target="" reason="" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) id="$2"; shift 2 ;; --to) target="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;; --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$id" ] || die "--id required"
  [ -n "$target" ] || die "--to required (info_none|low|medium|high|critical)"
  valid_sev "$target" || die "Invalid severity: $target"
  [ -n "$reason" ] || die "--reason required (audit trail)"
  target="$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')"
  printf '%s\n' "$id" | batch_stream severity_batch "$BATCH_SEVERITY" "$target" "$reason" "$apply"
}

cmd_recast_query() {
  need_auth; guard_severity_mode
  local query="" target="" reason="" apply=0 max=500
  while [ $# -gt 0 ]; do
    case "$1" in
      --query) query="$2"; shift 2 ;; --to) target="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;; --limit) max="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$query" ] || die "--query required"
  [ -n "$target" ] || die "--to required"
  valid_sev "$target" || die "Invalid severity: $target"
  [ -n "$reason" ] || die "--reason required"
  target="$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')"

  step "Query: $query"
  local t; t="$(mktemp)"
  findings_fetch "$query" "$max" | cut -f1 > "$t"
  local n; n="$(grep -c '[^[:space:]]' < "$t" || true)"
  [ "${n:-0}" -gt 0 ] || { rm -f "$t"; die "0 finding match query"; }
  ok "$n finding match"; info ""
  batch_stream severity_batch "$BATCH_SEVERITY" "$target" "$reason" "$apply" < "$t"
  local rc=$?; rm -f "$t"; return $rc
}

# CSV: finding_id,target_severity,reason   (reason may contain commas: the last
# column is joined from fields 3..NF)
# JSON: [{"finding_id":"...","target_severity":"high","reason":"..."}]
cmd_recast_bulk() {
  need_auth; guard_severity_mode
  local file="" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --file) file="$2"; shift 2 ;; --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$file" ] || die "--file required"
  [ -f "$file" ] || die "File not found: $file"

  # Three input shapes, because they arrive from different places:
  #   .json  hand-built or generated by another tool
  #   .tsv   produced by `findings list --export`, header-mapped, extra columns
  #          carried for human review and ignored here
  #   .csv   positional legacy: id, severity, reason (reason joins to end)
  # Header mapping matters for the export: it carries current_severity and name
  # so a reviewer can see what they are deciding on, and those columns must not
  # be mistaken for the decision columns.
  local norm; norm="$(mktemp)"
  case "$file" in
    *.json)
      jq -r '.[] | [.finding_id, (.target_severity//.severity//""), (.reason//"")] | @tsv' \
        "$file" > "$norm" 2>/dev/null || { rm -f "$norm"; die "Invalid JSON / wrong schema"; } ;;
    *.tsv)
      awk -F'\t' 'BEGIN{OFS="\t"; ci=0; ct=0; cr=0}
        NR==1 {
          for (i = 1; i <= NF; i++) {
            h = tolower($i); gsub(/^[ \t]+|[ \t]+$/, "", h)
            if (h ~ /^finding_?id$/)      ci = i
            else if (h == "target_severity") ct = i
            else if (h == "reason")          cr = i
          }
          if (ci == 0 || ct == 0) {
            print "HEADER_MISSING" > "/dev/stderr"; exit 3
          }
          next
        }
        {
          id = $ci; tg = tolower($ct); rs = (cr ? $cr : "")
          gsub(/^[ \t]+|[ \t]+$/, "", id); gsub(/[ \t]+/, "", tg)
          gsub(/^[ \t]+|[ \t]+$/, "", rs)
          if (id == "") next
          print id, tg, rs
        }' "$file" > "$norm" 2>/tmp/ddsec_hdr.$$ \
        || { rm -f "$norm"
             if grep -q HEADER_MISSING /tmp/ddsec_hdr.$$ 2>/dev/null; then
               rm -f /tmp/ddsec_hdr.$$
               die "The TSV header must have 'finding_id' and 'target_severity' columns.
  A file from '$PROG findings list --export' already carries them."
             fi
             rm -f /tmp/ddsec_hdr.$$; die "Failed to read $file"; }
      rm -f /tmp/ddsec_hdr.$$ ;;
    *)
      awk -F',' 'NR==1 && tolower($1) ~ /finding_?id/ { next }
                 NF>=2 { gsub(/^[ \t"]+|[ \t"]+$/,"",$1); gsub(/^[ \t"]+|[ \t"]+$/,"",$2)
                         r=""; for(i=3;i<=NF;i++){ r = r (i>3 ? "," : "") $i }
                         gsub(/^[ \t"]+|[ \t"]+$/,"",r)
                         printf "%s\t%s\t%s\n", $1, tolower($2), r }' "$file" > "$norm" ;;
  esac

  # An empty target_severity means "leave this one alone". That is what makes
  # the export round trip usable: fill in the rows you decided on, leave the
  # rest, no deleting required. An INVALID non-empty value still aborts.
  local skipped; skipped="$(awk -F'\t' '$2 == "" { c++ } END { print c+0 }' "$norm")"
  if [ "$skipped" -gt 0 ]; then
    awk -F'\t' '$2 != ""' "$norm" > "${norm}.keep" && mv "${norm}.keep" "$norm"
    dim "  $skipped rows skipped (empty target_severity = left unchanged)."
  fi

  local rows; rows="$(grep -c '[^[:space:]]' < "$norm" || true)"
  [ "${rows:-0}" -gt 0 ] || { rm -f "$norm"
    die "No rows with a filled target_severity in $file.
  Fill the target_severity column for the rows you want to change."; }
  step "$rows rows to change, from $file"

  # Validate everything BEFORE the first request. A half-applied bulk recast is
  # worse than a rejected one, so this fails closed on any bad row.
  local bad=0 lineno=0 fid sev rsn
  while IFS= read -r _row; do
    IFS=$'\x1f' read -r fid sev rsn <<< "${_row//$'\t'/$'\x1f'}"
    lineno=$(( lineno + 1 ))
    [ -n "${fid:-}" ]  || { warn "row $lineno: finding_id empty"; bad=1; }
    valid_sev "${sev:-}" || { warn "row $lineno: invalid severity '${sev:-}'"; bad=1; }
    [ -n "${rsn:-}" ]  || { warn "row $lineno: reason empty"; bad=1; }
  done < "$norm"
  [ "$bad" -eq 0 ] || { rm -f "$norm"; die "Invalid rows present, aborted (fail closed)."; }

  # Rows sharing a severity and reason go in one payload, so the number of
  # requests tracks distinct decisions rather than row count.
  local groups; groups="$(cut -f2,3 < "$norm" | sort -u)"
  local g_sev g_rsn sub rc=0
  info ""
  while IFS= read -r _g; do
    IFS=$'\x1f' read -r g_sev g_rsn <<< "${_g//$'\t'/$'\x1f'}"
    [ -n "${g_sev:-}" ] || continue
    sub="$(mktemp)"
    awk -F'\t' -v s="$g_sev" -v r="${g_rsn:-}" '$2==s && $3==r { print $1 }' "$norm" > "$sub"
    step "Group → $g_sev  ($(grep -c '[^[:space:]]' < "$sub") finding)  reason=\"${g_rsn:-}\""
    batch_stream severity_batch "$BATCH_SEVERITY" "$g_sev" "${g_rsn:-}" "$apply" < "$sub" || rc=1
    rm -f "$sub"
  done <<EOF
$groups
EOF
  rm -f "$norm"
  return $rc
}

# -----------------------------------------------------------------------------
# mute / unmute
# Reasons are enumerated by the API and differ by direction:
#   mute   PENDING_FIX FALSE_POSITIVE OTHER NO_FIX DUPLICATE RISK_ACCEPTED
#   unmute NO_PENDING_FIX HUMAN_ERROR NO_LONGER_ACCEPTED_RISK OTHER
# -----------------------------------------------------------------------------
MUTE_REASONS="PENDING_FIX FALSE_POSITIVE OTHER NO_FIX DUPLICATE RISK_ACCEPTED"
UNMUTE_REASONS="NO_PENDING_FIX HUMAN_ERROR NO_LONGER_ACCEPTED_RISK OTHER"

cmd_mute() {
  need_auth
  local id="" query="" reason="" unmute=0 apply=0 max=500 muted=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) id="$2"; shift 2 ;; --query) query="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;; --unmute) unmute=1; shift ;;
      --limit) max="$2"; shift 2 ;; --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$id" ] || [ -n "$query" ] || die "--id or --query required"
  [ -n "$reason" ] || die "--reason required"
  reason="$(printf '%s' "$reason" | tr '[:lower:]' '[:upper:]')"

  local allowed
  if [ "$unmute" -eq 1 ]; then muted=false; allowed="$UNMUTE_REASONS"
  else muted=true; allowed="$MUTE_REASONS"; fi
  printf '%s' "$allowed" | tr ' ' '\n' | grep -qx "$reason" \
    || die "Reason '$reason' is not valid for this direction.
  Valid: $allowed"

  local t; t="$(mktemp)"
  if [ -n "$id" ]; then
    printf '%s\n' "$id" > "$t"
  else
    step "Query: $query"
    findings_fetch "$query" "$max" | cut -f1 > "$t"
    local n; n="$(grep -c '[^[:space:]]' < "$t" || true)"
    [ "${n:-0}" -gt 0 ] || { rm -f "$t"; die "0 finding match query"; }
    ok "$n finding match"
  fi
  info ""
  batch_stream mute_batch "$BATCH_MUTE" "$muted" "$reason" "$apply" < "$t"
  local rc=$?; rm -f "$t"; return $rc
}

# -----------------------------------------------------------------------------
# severity modifier rules (documented, always key-auth)
# -----------------------------------------------------------------------------
cmd_rule_list() {
  need_auth
  dd_req_retry GET /api/v2/security/findings/automation/severity_modifier_rules \
    || { explain_http; return 1; }
  local n; n="$(printf '%s' "$HTTP_BODY" | jq -r '.data|length')"
  hdr "$n severity modifier rule (order = priority, first-match)"
  printf '%s' "$HTTP_BODY" | jq -r '
    .data[]? | [ .id, (.attributes.name // ""), (.attributes.action.type // ""),
                 (.attributes.action.value // .attributes.action.direction // ""),
                 ((.attributes.scope.finding_types // []) | join(",")) ] | @tsv' \
    | awk -F'\t' '{ printf "  %-38s %-30.30s %-6s %-9s %s\n", $1, $2, $3, $4, $5 }' >&2
  info ""
  dim "  Rules evaluate against @severity_details.adjusted.value, not @severity."
  dim "  The first matching rule is used; the rest are not evaluated."
}

cmd_rule_create() {
  need_auth
  local name="" target="" types="" query="" desc="" action="set" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --to) target="$2"; action="set"; shift 2 ;;
      --shift) target="$2"; action="shift"; shift 2 ;;
      --types) types="$2"; shift 2 ;; --query) query="$2"; shift 2 ;;
      --reason) desc="$2"; shift 2 ;; --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$name" ] || die "--name required"
  [ -n "$target" ] || die "--to <sev> or --shift up|down required"
  [ -n "$types" ] || die "--types required (e.g. static_code_vulnerability)"
  [ -n "$desc" ] || die "--reason required"

  # @severity and @severity_details.user_adjusted are rejected in a rule query.
  case "$query" in
    *@severity:*|*@severity_details.user_adjusted*)
      die "A rule query may not use @severity or @severity_details.user_adjusted.
  Rules evaluate against @severity_details.adjusted.value." ;;
  esac

  local attrs
  if [ "$action" = "set" ]; then
    valid_sev "$target" || die "Invalid severity: $target"
    attrs="$(jq -nc --arg v "$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')" '{type:"set", value:$v}')"
  else
    case "$target" in up|down) : ;; *) die "--shift must be up or down" ;; esac
    attrs="$(jq -nc --arg d "$target" '{type:"shift", direction:$d}')"
  fi

  local body
  body="$(jq -nc --arg name "$name" --arg q "$query" --arg desc "$desc" \
    --argjson action "$attrs" \
    --argjson types "$(printf '%s' "$types" | tr ',' '\n' | jq -R 'select(length>0)' | jq -sc .)" '
    { data: { type: "severity_modifier_rules",
              attributes: { name: $name, description: $desc, action: $action,
                            scope: ({ finding_types: $types }
                                    + (if $q == "" then {} else { query: $q } end)) } } }')"

  if [ "$apply" -eq 0 ]; then
    warn "DRY-RUN - payload that would be sent:"
    printf '%s\n' "$body" | jq . >&2
    dim "  Add --apply to create the rule."
    return 0
  fi

  dd_req_retry POST /api/v2/security/findings/automation/severity_modifier_rules "$body" \
    || { explain_http; return 1; }
  local rid; rid="$(printf '%s' "$HTTP_BODY" | jq -r '.data.id // ""')"
  ok "Rule created: $rid"
  audit_log rule "$rid" "create:${action}=${target}" "$desc" "$HTTP_CODE"
  dim "  Applies to new findings immediately; existing findings are checked within ~1h."
}

cmd_rule_delete() {
  need_auth
  local rid="" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) rid="$2"; shift 2 ;; --apply) apply=1; shift ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [ -n "$rid" ] || die "--id required"
  [ "$apply" -eq 1 ] || { warn "DRY-RUN: would DELETE rule $rid. Add --apply."; return 0; }
  dd_req_retry DELETE "/api/v2/security/findings/automation/severity_modifier_rules/$rid" \
    || { explain_http; return 1; }
  ok "Rule $rid deleted"
  audit_log rule "$rid" delete "" "$HTTP_CODE"
}

# -----------------------------------------------------------------------------
# Work Management (Case Management API v2)
#
# Two things about this API are worth knowing before debugging it:
#   1. A work type can only be used in a project it has been added to. A
#      mismatched pair makes POST /api/v2/cases return 400 with no detail.
#   2. There is NO attachment endpoint. A file cannot be uploaded to a work
#      item under any circumstances; detail has to live in comments.
# -----------------------------------------------------------------------------
# Paginated fetch of /api/v2/cases/projects into a JSON array on stdout.
#
# The previous version issued ONE request and printed whatever came back, which
# is why only 2 of 4 projects appeared. Two separate things can shorten that
# list, and they need different fixes, so both are handled here:
#
#   PAGING      the endpoint returns a page, not the whole set. Looped below.
#   ACCESS      a restricted project the caller cannot read is omitted by the
#               API even though the UI still lists its name. That is not a bug
#               to work around, it is an answer - see `work doctor`.
#
# The paging params for this endpoint are not documented. If the server ignores
# them, an offset loop would re-fetch page 1 forever, so identical ids across
# iterations stop the loop instead of spinning.
cases_projects_fetch() {
  local size=100 offset=0 acc="[]" page=0 got seen_before seen_now
  local all; all="$(mktemp)"
  printf '[]' > "$all"

  while :; do
    page=$(( page + 1 ))
    if ! dd_req_retry GET "/api/v2/cases/projects?page%5Bsize%5D=${size}&page%5Boffset%5D=${offset}"; then
      # Fall back to the bare endpoint: a rejected paging param must not turn
      # into "no projects at all".
      if [ "$page" -eq 1 ]; then
        dd_req_retry GET /api/v2/cases/projects || { explain_http; rm -f "$all"; return 1; }
      else
        break
      fi
    fi

    got="$(printf '%s' "$HTTP_BODY" | jq -r '(.data // []) | length')"
    [ "${got:-0}" -gt 0 ] || break

    seen_before="$(jq -r 'length' "$all")"
    acc="$(jq -s '.[0] + .[1] | unique_by(.id)' "$all" <(printf '%s' "$HTTP_BODY" | jq '.data // []'))"
    printf '%s' "$acc" > "$all"
    seen_now="$(jq -r 'length' "$all")"

    # Nothing new: either the last page, or the endpoint ignores page[offset].
    [ "$seen_now" -gt "$seen_before" ] || break
    [ "$got" -ge "$size" ] || break
    offset=$(( offset + size ))
    [ "$page" -lt 50 ] || { warn "Berhenti setelah 50 halaman project (pengaman)."; break; }
  done

  cat "$all"; rm -f "$all"
}

cmd_work_projects() {
  need_auth
  local json; json="$(cases_projects_fetch)" || return 1
  local n; n="$(printf '%s' "$json" | jq -r 'length')"

  hdr "$n Work Management projects (readable by this app key)"
  printf '%s' "$json" | jq -r '
    sort_by(.attributes.name // "") | .[] |
    [ .id, (.attributes.key // "?"), (.attributes.name // "?"),
      ((.attributes.restricted // false) | tostring) ] | @tsv' \
    | awk -F'\t' '{ printf "  %-38s %-12s %-34.34s restricted=%s\n", $1, $2, $3, $4 }' >&2
  info ""
  dim "  A restricted=false project is readable org-wide. Findings written"
  dim "  into it are visible org-wide."
  dim ""
  dim "  Fewer here than in the dashboard? That is not a display problem."
  dim "  The API omits projects this app key identity cannot read,"
  dim "  while the UI still shows their names. Check the cause:"
  dim "    $PROG work doctor --expect 'missing-project-name'"
}

# Answers one question: why does the API return fewer projects than the UI?
#
# It checks the three things that can cause it, in the order they are worth
# ruling out, and prints the restriction policy bindings side by side with the
# caller's own identity - which is the comparison that actually settles it.
cmd_work_doctor() {
  need_auth
  local expect=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --expect) expect="$2"; shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done

  hdr "1. Identity behind the app key"
  local me="" me_name="" me_email=""
  if dd_req GET /api/v2/current_user; then
    me="$(printf '%s' "$HTTP_BODY" | jq -r '.data.id // ""')"
    me_name="$(printf '%s' "$HTTP_BODY" | jq -r '.data.attributes.name // ""')"
    me_email="$(printf '%s' "$HTTP_BODY" | jq -r '.data.attributes.email // ""')"
    info "  user:${me}"
    info "  ${me_name:-?}  <${me_email:-?}>"
    dim "  All access below is evaluated against THIS identity, not"
    dim "  against your browser session. If both are the same user, the result"
    dim "  should match too - unless the app key is scoped (see section 2)."
  else
    warn "GET /api/v2/current_user failed (HTTP $HTTP_CODE) - identity cannot be confirmed."
  fi

  # A SCOPED app key is the one cause that makes the same user see less through
  # the API than in the browser. Matched by last4 so the key in use is named,
  # not guessed.
  hdr "2. Scope app key"
  local l4="${DD_APP_KEY_R: -4}"
  if dd_req GET /api/v2/current_user/application_keys; then
    local row
    row="$(printf '%s' "$HTTP_BODY" | jq -r --arg l4 "$l4" '
      [ .data[]? | select((.attributes.last4 // "") == $l4) ][0] // empty')"
    if [ -n "$row" ]; then
      info "  name   : $(printf '%s' "$row" | jq -r '.attributes.name // "?"')"

      # The previous version warned whenever `scopes` was non-empty. That was
      # wrong and actively misleading: a key can carry hundreds of scopes AND
      # still include cases_read. What matters is whether the specific scopes
      # this tool needs are present, so each one is checked BY NAME and the
      # verdict comes from that check - never from the mere presence of a list.
      local nscope missing="" sc
      nscope="$(printf '%s' "$row" | jq -r '(.attributes.scopes // []) | length')"
      if [ "${nscope:-0}" -eq 0 ]; then
        info "  scopes : <not scoped: inherits all the user's permissions>"
        dim "  Not the cause. Continue to section 4."
      else
        info "  scopes : $nscope scopes listed; the ones relevant to this tool:"
        for sc in cases_read cases_write security_monitoring_findings_read \
                  security_monitoring_findings_write security_pipelines_read \
                  code_analysis_read; do
          if printf '%s' "$row" | jq -e --arg s "$sc" \
               '((.attributes.scopes // []) | index($s)) != null' >/dev/null 2>&1; then
            printf '    %s✓%s %s\n' "$C_GRN" "$C_OFF" "$sc" >&2
          else
            printf '    %s✗%s %s\n' "$C_RED" "$C_OFF" "$sc" >&2
            missing="${missing:+$missing }$sc"
          fi
        done
        if [ -z "$missing" ]; then
          ok "  All required scopes are PRESENT - scope is NOT the cause."
          dim "  Continue to section 4: the cause is a restriction policy, not the key."
        else
          warn "  Missing scopes:$missing"
          dim "  If cases_read is among the missing, that is the cause. If"
          dim "  cases_read is PRESENT but the project is still missing, continue to section 4."
        fi
      fi
    else
      dim "  A key with last4='$l4' is not in this user's app key list."
      dim "  That means the app key belongs to ANOTHER user (e.g. a service account),"
      dim "  so the access evaluated is that user's, not yours."
    fi
  else
    dim "  Cannot read the app key list (HTTP $HTTP_CODE). Skipping."
  fi

  hdr "3. Projects readable via the API"
  local json n
  json="$(cases_projects_fetch)" || return 1
  n="$(printf '%s' "$json" | jq -r 'length')"
  info "  $n project"
  printf '%s' "$json" | jq -r '
    sort_by(.attributes.name // "") | .[] |
    "  \(.attributes.key // "?")\u0009\(.attributes.name // "?")\u0009restricted=\((.attributes.restricted // false)|tostring)"' \
    | awk -F'\t' '{ printf "  %-12s %-34.34s %s\n", $1, $2, $3 }' >&2

  hdr "4. Restriction policy per project"
  dim "  This policy decides who can read. A principal NOT"
  dim "  listed at all has no access - including the rest of the org."
  local pid pkey
  printf '%s' "$json" | jq -r '.[] | "\(.id)\u0009\(.attributes.key // "?")"' \
  | while IFS= read -r _row; do
      IFS=$'\x1f' read -r pid pkey <<< "${_row//$'\t'/$'\x1f'}"
      [ -n "${pid:-}" ] || continue
      if dd_req GET "/api/v2/restriction_policy/case-management-project:${pid}"; then
        local b
        b="$(printf '%s' "$HTTP_BODY" | jq -r '
          (.data.attributes.bindings // [])
          | if length == 0 then "    <no policy: open to the whole org>"
            else map("    \(.relation): \((.principals // []) | join(", "))") | join("\n") end')"
        info "  ${pkey} (${pid})"
        info "$b"
      else
        info "  ${pkey} (${pid})"
        case "$HTTP_CODE" in
          404) dim "    <no restriction policy: open to the whole org>" ;;
          403) dim "    policy EXISTS but this identity may not read it" ;;
          *)   dim "    cannot be read (HTTP $HTTP_CODE)" ;;
        esac
      fi
    done

  if [ -n "$expect" ]; then
    hdr "5. Projects you expect to exist"
    local want missing=0
    printf '%s' "$expect" | tr ',' '\n' | while IFS= read -r want; do
      want="$(printf '%s' "$want" | sed 's/^[ \t]*//; s/[ \t]*$//')"
      [ -n "$want" ] || continue
      if printf '%s' "$json" | jq -e --arg w "$want" '
           any(.[]; ((.attributes.name // "") | ascii_downcase) == ($w | ascii_downcase)
                    or ((.attributes.key // "") | ascii_downcase) == ($w | ascii_downcase))' >/dev/null 2>&1; then
        ok "  '$want' READABLE via the API"
      else
        warn "  '$want' NOT readable via the API"
        dim "    If this project appears in the dashboard, then the identity in"
        dim "    section 1 is not included in its restriction policy. The UI still"
        dim "    shows the name; the API omits it - and the API is correct."
        dim "    Open in the UI: Work Management → that project → Settings → Access,"
        dim "    then add the user/team from section 1 as at least Viewer."
      fi
    done
  fi

  info ""
  hdr "How to read this"
  dim "  Read section 2 first:"
  dim "    cases_read KURANG → that is the cause, done."
  dim "    cases_read ADA    → scope is not the cause; the cause is a restriction"
  dim "                        policy on the missing project."
  dim ""
  dim "  The missing project's policy CANNOT be read from here: a project that"
  dim "  is unreadable also does not appear in section 3, so its id is unknown."
  dim "  Take its id from the project URL in the UI, then:"
  dim "    $PROG work project-access --id <uuid-from-url>"
  dim ""
  dim "  Projects auto-created by the SAST gate hit this most often:"
  dim "  the gate locks the project it created and only binds its own team"
  dim "  plus identitasnya sendiri."
}

# Reads the restriction policy of ANY project id, including one that does not
# appear in `work projects`.
#
# This is the piece `work doctor` cannot do on its own: a project the identity
# cannot read is absent from the listing, so its id is unknown. The id is
# visible in the project URL in the UI, and a restriction policy can be read by
# id even when the project itself cannot be listed - which is exactly what
# settles whether the cause is access rather than paging.
cmd_work_project_access() {
  need_auth
  local pid=""
  while [ $# -gt 0 ]; do
    case "$1" in --id) pid="$2"; shift 2 ;; *) die "Unknown argument: $1" ;; esac
  done
  [ -n "$pid" ] || die "--id required.
  Take the UUID from the project URL in the UI, e.g.
  $(app_base "${DD_SITE_R:-datadoghq.com}")/cases/projects/<UUID>"

  local me; me="$(self_principal || true)"
  hdr "Akses project $pid"
  [ -z "$me" ] || info "  app key identity  : user:${me}"

  printf '  readable in list : ' >&2
  local json
  json="$(cases_projects_fetch 2>/dev/null)" || json='[]'
  if printf '%s' "$json" | jq -e --arg p "$pid" 'any(.[]; .id == $p)' >/dev/null 2>&1; then
    printf '%sya%s (%s)\n' "$C_GRN" "$C_OFF" \
      "$(printf '%s' "$json" | jq -r --arg p "$pid" '[.[]|select(.id==$p)|.attributes.name][0] // "?"')" >&2
  else
    printf '%stidak%s\n' "$C_RED" "$C_OFF" >&2
  fi

  info ""
  info "  Restriction policy:"
  if dd_req GET "/api/v2/restriction_policy/case-management-project:${pid}"; then
    local b
    b="$(printf '%s' "$HTTP_BODY" | jq -r '
      (.data.attributes.bindings // [])
      | if length == 0 then "    <empty policy: open to the whole org>"
        else map("    \(.relation): \((.principals // []) | join(", "))") | join("\n") end')"
    info "$b"
    info ""
    if [ -n "$me" ]; then
      if printf '%s' "$HTTP_BODY" | jq -e --arg me "user:${me}" \
           '[(.data.attributes.bindings // [])[].principals[]?] | index($me) != null' >/dev/null 2>&1; then
        ok "  The app key identity is bound DIRECTLY in this policy."
        dim "  If the project still is not readable, report it - that is abnormal."
      else
        warn "  The app key identity is NOT bound directly in this policy."
        dim "  Access may still come via a team: or role: binding above -"
        dim "  that follows membership, and membership cannot be checked"
        dim "  from this endpoint. If this project is not readable in the list,"
        dim "  it means you are indeed not a member."
        dim ""
        dim "  Fix: UI → project → Settings → Access, add"
        dim "  user:${me} as at least Viewer; or add that identity"
        dim "  to one of the teams already bound above."
      fi
    fi
  else
    case "$HTTP_CODE" in
      404) dim "    <no policy>"
           info ""
           dim "  Without a policy, the project is open to the whole org. So if"
           dim "  this project still is not readable in the list, the cause is NOT"
           dim "  restriction policy - and not scope (section 2, doctor)."
           dim "  Remaining possibilities: the id is wrong, or the project is in another org."
           dim "  Check DD_SITE now: ${DD_SITE_R}" ;;
      403) dim "    may not be read by this identity (HTTP 403)"
           info ""
           dim "  a 403 here is itself the answer: the policy exists and"
           dim "  this identity is not part of it." ;;
      *)   dim "    failed to read (HTTP $HTTP_CODE): $(api_error)" ;;
    esac
  fi
}


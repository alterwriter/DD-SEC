<tr><td><span class="chip HIGH">HIGH</span></td><td>$F_HIGH</td></tr>
<tr><td><span class="chip MEDIUM">MEDIUM</span></td><td>$F_MED</td></tr>
<tr><td><span class="chip LOW">LOW</span></td><td>$F_LOW</td></tr>
<tr><td><span class="chip INFO">INFO</span></td><td>$F_INFO</td></tr>
<tr><td><span class="chip UNKNOWN">UNKNOWN</span></td><td>$F_UNK</td></tr>
</table>
<h2>Top findings (up to $topn, severity-ranked)</h2>
<table><tr><th>#</th><th>Severity</th><th>Status</th><th>Finding</th><th>Resource</th></tr>
HTMLHEAD
      local _n=0 id sev st ti rs
      while IFS=$'\t' read -r id sev st ti rs; do
        [ -n "$id" ] || continue
        _n=$(( _n + 1 ))
        local sv; sv="$(_rep_up "${sev:-unknown}")"; [ -n "$sev" ] || sv="UNKNOWN"
        printf '<tr><td>%d</td><td><span class="chip %s">%s</span></td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
          "$_n" "$sv" "$sv" "$(_rep_html_esc "${st:--}")" "$(_rep_html_esc "${ti:--}")" "$(_rep_html_esc "${rs:--}")"
      done < "$ftop"
      printf '</table>\n'

      printf '<h2>SAST violations (cicodescan)</h2>\n'
      if [ "$sast_ok" -eq 1 ]; then
        cat <<HTMLSAST
<div class="cards">
  <div class="card"><div class="n">$S_TOT</div><div class="l">Total</div></div>
  <div class="card"><div class="n">$S_CRIT</div><div class="l">Critical</div></div>
  <div class="card"><div class="n">$S_HIGH</div><div class="l">High</div></div>

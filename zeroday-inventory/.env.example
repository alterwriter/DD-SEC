# Copy to .env and fill in. zeroday.sh parses this safely (KEY=VALUE only; it
# does NOT `source` the file, so no shell code here is executed).
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APP_KEY=

# Optional defaults for non-interactive / repeated runs
DEFAULT_SCOPE=js,php
DEFAULT_ENV=
DEFAULT_LOOKBACK=now-7d
